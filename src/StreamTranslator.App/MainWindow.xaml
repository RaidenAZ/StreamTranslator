<ui:FluentWindow x:Class="StreamTranslator.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="StreamTranslator"
                 Width="1120"
                 Height="760"
                 MinWidth="960"
                 MinHeight="640"
                 ResizeMode="CanResize"
                 WindowStartupLocation="CenterScreen"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 ExtendsContentIntoTitleBar="True"
                 Background="Transparent"
                 Loaded="OnLoaded"
                 Closing="OnClosing">
    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="AppTitleBar"
                     Grid.Row="0"
                     Title=""
                     Height="48"
                     ShowMinimize="True"
                     ShowMaximize="True"
                     ShowClose="True"
                     ForceShutdown="False"
                     Background="{StaticResource ChromeBrush}">
            <ui:TitleBar.Header>
                <TextBlock Text="StreamTranslator"
                           AutomationProperties.AutomationId="TitleBarAppTitle"
                           FontSize="13"
                           FontWeight="Normal"
                           Margin="16,0,0,0"
                           VerticalAlignment="Center" />
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <ui:NavigationView x:Name="MainNavigation"
                           Grid.Row="1"
                           AutomationProperties.AutomationId="MainNavigation"
                           PaneDisplayMode="LeftFluent"
                           IsPaneOpen="True"
                           IsPaneToggleVisible="False"
                           IsBackButtonVisible="Collapsed"
                           HeaderVisibility="Collapsed"
                           AlwaysShowHeader="False"
                           Background="Transparent">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="主页"
                                       Tag="HomePage"
                                       AutomationProperties.AutomationId="NavHomePage"
                                       AutomationProperties.ItemStatus="Active"
                                       FontSize="12"
                                       Click="OnNavClick"
                                       IsActive="True">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Home24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="字幕历史"
                                       Tag="SubtitleHistoryPage"
                                       AutomationProperties.AutomationId="NavSubtitleHistoryPage"
                                       AutomationProperties.ItemStatus="Inactive"
                                       FontSize="12"
                                       Click="OnNavClick">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="ClosedCaption24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="设置"
                                       Tag="SettingsPage"
                                       AutomationProperties.AutomationId="NavSettingsPage"
                                       AutomationProperties.ItemStatus="Inactive"
                                       FontSize="12"
                                       Click="OnNavClick">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Settings24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="关于"
                                       Tag="AboutPage"
                                       AutomationProperties.AutomationId="NavAboutPage"
                                       AutomationProperties.ItemStatus="Inactive"
                                       FontSize="12"
                                       Click="OnNavClick">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Info24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.FooterMenuItems>

            <ui:NavigationView.ContentOverlay>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="28,22,28,28">
                        <Grid x:Name="HomePage">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,18">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Home24"
                                                       FontSize="24"
                                                       Margin="0,0,10,0"
                                                       VerticalAlignment="Center" />
                                        <TextBlock Text="实时字幕"
                                                   FontSize="24"
                                                   FontWeight="Medium"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Border DockPanel.Dock="Right"
                                            HorizontalAlignment="Right"
                                            Background="#E8F1FF"
                                            BorderBrush="#B9D1FF"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="10,5">
                                        <TextBlock x:Name="HomeStateBadgeText"
                                                   Text="就绪"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold" />
                                    </Border>
                                </DockPanel>

                                <Border x:Name="HomeControlBar"
                                        Style="{StaticResource PanelBorder}"
                                        Padding="30">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,22">
                                            <TextBlock Text="字幕概览"
                                                       AutomationProperties.AutomationId="HomeOverviewPanel"
                                                       FontSize="16"
                                                       FontWeight="Medium"
                                                       Foreground="{StaticResource PrimaryTextBrush}" />
                                            <StackPanel DockPanel.Dock="Right"
                                                        Orientation="Horizontal"
                                                        HorizontalAlignment="Right">
                                                <ui:Button x:Name="StartStopButton"
                                                           AutomationProperties.AutomationId="StartStopButton"
                                                           Click="OnStartStopClick"
                                                           Height="38"
                                                           MinWidth="116"
                                                           Padding="14,0"
                                                           FontSize="14"
                                                           Margin="0,0,8,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <ui:SymbolIcon x:Name="StartStopIcon" Symbol="Play24" Margin="0,0,8,0" />
                                                        <TextBlock x:Name="StartStopText" Text="开始字幕" />
                                                    </StackPanel>
                                                </ui:Button>
                                                <ui:Button x:Name="HomeFloatingWindowButton"
                                                           AutomationProperties.AutomationId="HomeFloatingWindowButton"
                                                           AutomationProperties.Name="显示悬浮窗"
                                                           Click="OnShowFloatingWindowClick"
                                                           Height="38"
                                                           MinWidth="112"
                                                           Padding="12,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <ui:SymbolIcon x:Name="FloatingWindowIcon" Symbol="Window24" Margin="0,0,8,0" />
                                                        <TextBlock Text="悬浮窗" />
                                                    </StackPanel>
                                                </ui:Button>
                                            </StackPanel>
                                        </DockPanel>

                                        <Grid Margin="0,0,0,24">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="24" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="24" />
                                                <ColumnDefinition Width="300" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="当前状态" Style="{StaticResource FieldLabelText}" />
                                                <TextBlock x:Name="HomeRuntimeSummaryText"
                                                           AutomationProperties.AutomationId="HomeControlBar"
                                                           Text="未启动，等待开始"
                                                           FontSize="15"
                                                           FontWeight="Medium"
                                                           Foreground="{StaticResource PrimaryTextBrush}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="输出设备" Style="{StaticResource FieldLabelText}" />
                                                <TextBlock x:Name="CurrentAudioDeviceText"
                                                           AutomationProperties.AutomationId="HomeAudioDeviceText"
                                                           Text="默认设备"
                                                           FontSize="14"
                                                           Foreground="{StaticResource PrimaryTextBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="4">
                                                <DockPanel Margin="0,0,0,8">
                                                    <TextBlock Text="输入电平" Style="{StaticResource FieldLabelText}" />
                                                    <TextBlock x:Name="HomeAudioLevelText"
                                                               DockPanel.Dock="Right"
                                                               Text="0%"
                                                               FontSize="13"
                                                               Foreground="{StaticResource SecondaryTextBrush}"
                                                               HorizontalAlignment="Right" />
                                                </DockPanel>
                                                <ProgressBar x:Name="AudioLevelBar"
                                                             AutomationProperties.AutomationId="HomeAudioLevelBar"
                                                             Minimum="0"
                                                             Maximum="100"
                                                             Height="8" />
                                            </StackPanel>
                                        </Grid>

                                        <Border Height="1"
                                                Background="{StaticResource StrokeBrush}"
                                                Margin="0,0,0,20" />

                                        <TextBlock Text="运行链路"
                                                   FontSize="13"
                                                   FontWeight="Medium"
                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                   Margin="0,0,0,12" />
                                        <Grid Margin="0,0,0,22">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="18" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <StackPanel Grid.Row="0" Grid.Column="0">
                                                <TextBlock Text="音频输入" Style="{StaticResource FieldLabelText}" />
                                                <TextBlock x:Name="AudioStatusText"
                                                           AutomationProperties.AutomationId="OverviewAudioInputStatus"
                                                           Text="未启动"
                                                           FontSize="15"
                                                           FontWeight="Medium" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="0" Grid.Column="1">
                                                <TextBlock Text="语音检测" Style="{StaticResource FieldLabelText}" />
                                                <TextBlock x:Name="VadStatusText"
                                                           AutomationProperties.AutomationId="OverviewSpeechDetectionStatus"
                                                           Text="等待模型"
                                                           FontSize="15"
                                                           FontWeight="Medium" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="0" Grid.Column="2">
                                                <TextBlock Text="识别进程" Style="{StaticResource FieldLabelText}" />
                                                <TextBlock x:Name="WorkerStatusText"
                                                           AutomationProperties.AutomationId="OverviewRecognitionWorkerStatus"
                                                           Text="未启动"
                                                           FontSize="15"
                                                           FontWeight="Medium" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="0" Grid.Column="3">
                                                <TextBlock Text="识别接口" Style="{StaticResource FieldLabelText}" />
                                                <TextBlock x:Name="ApiStatusText"
                                                           AutomationProperties.AutomationId="OverviewRecognitionApiStatus"
                                                           Text="未测试"
                                                           FontSize="15"
                                                           FontWeight="Medium" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="2" Grid.Column="0">
                                                <TextBlock Text="翻译进程" Style="{StaticResource FieldLabelText}" />
                                                <TextBlock x:Name="TranslationWorkerStatusText"
                                                           AutomationProperties.AutomationId="OverviewTranslationWorkerStatus"
                                                           Text="已关闭"
                                                           FontSize="15"
                                                           FontWeight="Medium" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="2" Grid.Column="1">
                                                <TextBlock Text="翻译接口" Style="{StaticResource FieldLabelText}" />
                                                <TextBlock x:Name="TranslationApiStatusText"
                                                           AutomationProperties.AutomationId="OverviewTranslationApiStatus"
                                                           Text="已关闭"
                                                           FontSize="15"
                                                           FontWeight="Medium" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="2" Grid.Column="2">
                                                <TextBlock Text="字幕输出" Style="{StaticResource FieldLabelText}" />
                                                <TextBlock x:Name="SubtitleOutputStatusText"
                                                           AutomationProperties.AutomationId="OverviewSubtitleOutputStatus"
                                                           Text="等待字幕"
                                                           FontSize="15"
                                                           FontWeight="Medium" />
                                            </StackPanel>
                                        </Grid>

                                    </StackPanel>
                                </Border>

                                <Border x:Name="HomeIssuesCard"
                                        Style="{StaticResource PanelBorder}"
                                        Padding="30,22">
                                    <StackPanel>
                                        <TextBlock Text="问题"
                                                   AutomationProperties.AutomationId="HomeIssuesPanel"
                                                   FontSize="13"
                                                   FontWeight="Medium"
                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                   Margin="0,0,0,10" />
                                        <TextBlock x:Name="LastErrorText"
                                                   Text="无"
                                                   TextWrapping="Wrap"
                                                   FontSize="14"
                                                   Foreground="{StaticResource PrimaryTextBrush}" />
                                        <TextBlock x:Name="TranslationIssueText"
                                                   AutomationProperties.AutomationId="HomeTranslationIssueText"
                                                   Visibility="Collapsed"
                                                   TextWrapping="Wrap"
                                                   FontSize="14"
                                                   Foreground="#B54708"
                                                   Margin="0,12,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <Grid x:Name="SubtitleHistoryPage" Visibility="Collapsed">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,18">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="字幕历史" FontSize="24" FontWeight="Medium" />
                                        <TextBlock x:Name="SubtitleHistoryCopyStatusText"
                                                   AutomationProperties.AutomationId="SubtitleHistoryCopyStatus"
                                                   Text=""
                                                   Margin="12,6,0,0"
                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                   FontSize="13" />
                                    </StackPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <ui:Button AutomationProperties.AutomationId="CopySelectedSubtitleButton"
                                                   Click="OnCopySelectedClick"
                                                   Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Copy24" Margin="0,0,8,0" />
                                                <TextBlock Text="复制选中" />
                                            </StackPanel>
                                        </ui:Button>
                                        <ui:Button AutomationProperties.AutomationId="CopyRecentSubtitlesButton"
                                                   Click="OnCopyRecentClick"
                                                   Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="History24" Margin="0,0,8,0" />
                                                <TextBlock Text="复制最近 10 条" />
                                            </StackPanel>
                                        </ui:Button>
                                        <ui:Button AutomationProperties.AutomationId="CopyAllSubtitlesButton"
                                                   Click="OnCopyAllClick"
                                                   Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="ClipboardTextLtr24" Margin="0,0,8,0" />
                                                <TextBlock Text="复制当天全部" />
                                            </StackPanel>
                                        </ui:Button>
                                        <ui:Button AutomationProperties.AutomationId="ClearHistoryButton"
                                                   Click="OnClearHistoryClick">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Dismiss24" Margin="0,0,8,0" />
                                                <TextBlock Text="清空当天历史" />
                                            </StackPanel>
                                        </ui:Button>
                                    </StackPanel>
                                </DockPanel>

                                <Border Style="{StaticResource PanelBorder}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top"
                                                   Text="今天"
                                                   Style="{StaticResource SectionTitleText}" />
                                        <Grid>
                                            <TextBlock x:Name="SubtitlePlaceholderText"
                                                       Text="开始字幕后，这里会保存今天的字幕记录。"
                                                       Margin="12,10"
                                                       Foreground="{StaticResource SecondaryTextBrush}"
                                                       FontSize="14"
                                                       IsHitTestVisible="False" />
                                            <ListBox x:Name="SubtitleList"
                                                     AutomationProperties.AutomationId="SubtitleHistoryList"
                                                     MinHeight="500"
                                                     BorderThickness="0"
                                                     Background="Transparent"
                                                     HorizontalContentAlignment="Stretch"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                                <ListBox.ItemContainerStyle>
                                                    <Style TargetType="{x:Type ListBoxItem}">
                                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                        <Setter Property="Padding" Value="12,8" />
                                                    </Style>
                                                </ListBox.ItemContainerStyle>
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid HorizontalAlignment="Stretch">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="64" />
                                                                <ColumnDefinition Width="12" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0"
                                                                       Text="{Binding GeneratedTimeText}"
                                                                       FontFamily="Consolas"
                                                                       FontSize="12"
                                                                       Foreground="{StaticResource SecondaryTextBrush}"
                                                                       Margin="0,2,0,0"
                                                                       VerticalAlignment="Top" />
                                                            <StackPanel Grid.Column="2" HorizontalAlignment="Stretch">
                                                                <TextBlock Text="{Binding SourceText}"
                                                                           TextWrapping="Wrap"
                                                                           FontSize="15"
                                                                           LineHeight="22"
                                                                           Foreground="{StaticResource PrimaryTextBrush}" />
                                                                <TextBlock Text="{Binding TranslatedText}"
                                                                           TextWrapping="Wrap"
                                                                           FontSize="14"
                                                                           LineHeight="21"
                                                                           Foreground="{StaticResource SecondaryTextBrush}"
                                                                           Margin="0,3,0,0">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding TranslatedText}" Value="{x:Null}">
                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding TranslatedText}" Value="">
                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </Grid>
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <Grid x:Name="SettingsPage" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="设置" FontSize="24" FontWeight="Medium" Margin="0,0,0,18" />

                                <Border Style="{StaticResource PanelBorder}">
                                    <StackPanel>
                                        <TextBlock Text="音频"
                                                   AutomationProperties.AutomationId="SettingsAudioGroup"
                                                   Style="{StaticResource SectionTitleText}" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="24" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,12">
                                                <TextBlock Text="输出设备" Style="{StaticResource FieldLabelText}" />
                                                <ComboBox x:Name="AudioDeviceComboBox"
                                                          AutomationProperties.AutomationId="AudioDeviceComboBox"
                                                          Height="36"
                                                          SelectionChanged="OnAudioDeviceSelectionChanged" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,12">
                                                <TextBlock Text="默认设备" Style="{StaticResource FieldLabelText}" />
                                                <ui:ToggleSwitch x:Name="FollowDefaultDeviceSwitch"
                                                                 AutomationProperties.AutomationId="FollowDefaultDeviceSwitch"
                                                                 Content="跟随系统默认设备"
                                                                 IsChecked="True" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="1"
                                                        Grid.Column="0"
                                                        Grid.ColumnSpan="3"
                                                        Margin="0,0,0,12">
                                                <StackPanel.Resources>
                                                    <Style x:Key="VadModeOptionStyle" TargetType="{x:Type RadioButton}">
                                                        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
                                                        <Setter Property="FontSize" Value="13" />
                                                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="{x:Type RadioButton}">
                                                                    <Border x:Name="ModeBorder"
                                                                            Margin="2"
                                                                            Padding="14,8"
                                                                            CornerRadius="4"
                                                                            Background="Transparent">
                                                                        <TextBlock Text="{TemplateBinding Content}"
                                                                                   Foreground="{TemplateBinding Foreground}"
                                                                                   HorizontalAlignment="Center" />
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="ModeBorder" Property="Background" Value="#12000000" />
                                                                        </Trigger>
                                                                        <Trigger Property="IsChecked" Value="True">
                                                                            <Setter TargetName="ModeBorder" Property="Background" Value="{StaticResource AccentBrush}" />
                                                                            <Setter Property="Foreground" Value="White" />
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </StackPanel.Resources>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="24" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Text="断句策略"
                                                               Style="{StaticResource FieldLabelText}" />
                                                    <TextBlock x:Name="CurrentVadEndpointText"
                                                               AutomationProperties.AutomationId="CurrentVadEndpointText"
                                                               Grid.Column="2"
                                                               Text="当前断句等待：400ms（均衡，自适应）"
                                                               FontSize="12"
                                                               Foreground="{StaticResource SecondaryTextBrush}"
                                                               HorizontalAlignment="Left" />
                                                </Grid>
                                                <Border BorderBrush="{StaticResource StrokeBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        HorizontalAlignment="Left">
                                                    <Grid Width="456">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <RadioButton x:Name="LowLatencyVadModeButton"
                                                                     Grid.Column="0"
                                                                     GroupName="VadEndpointMode"
                                                                     Content="低延迟"
                                                                     Tag="LowLatency"
                                                                     AutomationProperties.AutomationId="VadModeLowLatency"
                                                                     Checked="OnVadEndpointModeChecked"
                                                                     Style="{StaticResource VadModeOptionStyle}" />
                                                        <RadioButton x:Name="BalancedVadModeButton"
                                                                     Grid.Column="1"
                                                                     GroupName="VadEndpointMode"
                                                                     Content="均衡"
                                                                     Tag="Balanced"
                                                                     IsChecked="True"
                                                                     AutomationProperties.AutomationId="VadModeBalanced"
                                                                     Checked="OnVadEndpointModeChecked"
                                                                     Style="{StaticResource VadModeOptionStyle}" />
                                                        <RadioButton x:Name="SentenceCompleteVadModeButton"
                                                                     Grid.Column="2"
                                                                     GroupName="VadEndpointMode"
                                                                     Content="句子完整"
                                                                     Tag="SentenceComplete"
                                                                     AutomationProperties.AutomationId="VadModeSentenceComplete"
                                                                     Checked="OnVadEndpointModeChecked"
                                                                     Style="{StaticResource VadModeOptionStyle}" />
                                                        <RadioButton x:Name="FixedVadModeButton"
                                                                     Grid.Column="3"
                                                                     GroupName="VadEndpointMode"
                                                                     Content="固定值"
                                                                     Tag="Fixed"
                                                                     AutomationProperties.AutomationId="VadModeFixed"
                                                                     Checked="OnVadEndpointModeChecked"
                                                                     Style="{StaticResource VadModeOptionStyle}" />
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,12">
                                                <TextBlock Text="固定断句等待" Style="{StaticResource FieldLabelText}" />
                                                <ui:NumberBox x:Name="EndSilenceBox"
                                                              AutomationProperties.AutomationId="FixedEndSilenceBox"
                                                              Value="400"
                                                              Minimum="200"
                                                              Maximum="800"
                                                              SmallChange="50"
                                                              LargeChange="100"
                                                              Width="180"
                                                              IsEnabled="False"
                                                              ValueChanged="OnFixedEndSilenceValueChanged"
                                                              HorizontalAlignment="Left" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,12">
                                                <TextBlock Text="最短片段 (ms)" Style="{StaticResource FieldLabelText}" />
                                                <ui:NumberBox x:Name="MinSegmentBox"
                                                              Value="900"
                                                              Minimum="300"
                                                              Maximum="3000"
                                                              SmallChange="100"
                                                              LargeChange="300"
                                                              Width="180"
                                                              HorizontalAlignment="Left" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="3" Grid.Column="0">
                                                <TextBlock Text="最长片段 (ms)" Style="{StaticResource FieldLabelText}" />
                                                <ui:NumberBox x:Name="HardMaxSegmentBox"
                                                              AutomationProperties.AutomationId="HardMaxSegmentBox"
                                                              Value="10000"
                                                              Minimum="6000"
                                                              Maximum="20000"
                                                              SmallChange="1000"
                                                              LargeChange="2000"
                                                              Width="180"
                                                              HorizontalAlignment="Left" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="3" Grid.Column="2">
                                                <TextBlock Text="自适应状态" Style="{StaticResource FieldLabelText}" />
                                                <TextBlock x:Name="AdaptiveVadStatusText"
                                                           AutomationProperties.AutomationId="AdaptiveVadStatusText"
                                                           Text="等待运行"
                                                           FontSize="12"
                                                           Foreground="{StaticResource SecondaryTextBrush}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource PanelBorder}">
                                    <StackPanel>
                                        <TextBlock Text="识别服务"
                                                   AutomationProperties.AutomationId="SettingsRecognitionGroup"
                                                   Style="{StaticResource SectionTitleText}" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="24" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,12">
                                                <TextBlock Text="API Key" Style="{StaticResource FieldLabelText}" />
                                                <PasswordBox x:Name="ApiKeyBox" Height="36" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,12">
                                                <TextBlock Text="Base URL" Style="{StaticResource FieldLabelText}" />
                                                <TextBox x:Name="BaseUrlBox" Height="36" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,12">
                                                <TextBlock Text="Model" Style="{StaticResource FieldLabelText}" />
                                                <TextBox x:Name="ModelBox" Text="mimo-v2.5-asr" Height="36" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,12">
                                                <TextBlock Text="识别语言" Style="{StaticResource FieldLabelText}" />
                                                <TextBox x:Name="LanguageBox"
                                                         AutomationProperties.AutomationId="AsrLanguageBox"
                                                         Text="自动检测 (auto)"
                                                         Height="36"
                                                         IsReadOnly="True"
                                                         IsTabStop="False" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="2" Grid.Column="0">
                                                <TextBlock Text="请求超时 ms" Style="{StaticResource FieldLabelText}" />
                                                <ui:NumberBox x:Name="TimeoutBox"
                                                              Value="30000"
                                                              Minimum="5000"
                                                              Maximum="120000"
                                                              SmallChange="1000"
                                                              LargeChange="5000"
                                                              Width="180"
                                                              HorizontalAlignment="Left" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="2" Grid.Column="2">
                                                <TextBlock Text="最大并发" Style="{StaticResource FieldLabelText}" />
                                                <ui:NumberBox x:Name="MaxConcurrencyBox"
                                                              Value="2"
                                                              Minimum="1"
                                                              Maximum="4"
                                                              SmallChange="1"
                                                              LargeChange="1"
                                                              Width="180"
                                                              HorizontalAlignment="Left" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border x:Name="TranslationSettingsPanel"
                                        Style="{StaticResource PanelBorder}">
                                    <StackPanel>
                                        <TextBlock Text="字幕翻译"
                                                   AutomationProperties.AutomationId="SettingsTranslationGroup"
                                                   Style="{StaticResource SectionTitleText}" />

                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="24" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="目标语言" Style="{StaticResource FieldLabelText}" />
                                                <ComboBox x:Name="TranslationTargetLanguageBox"
                                                          AutomationProperties.AutomationId="TranslationTargetLanguageBox"
                                                          Height="36"
                                                          Width="280"
                                                          HorizontalAlignment="Left"
                                                          SelectionChanged="OnTranslationSettingChanged">
                                                    <ComboBoxItem Content="中文" Tag="zh-Hans" />
                                                    <ComboBoxItem Content="英语" Tag="en" />
                                                    <ComboBoxItem Content="德语" Tag="de" />
                                                    <ComboBoxItem Content="法语" Tag="fr" />
                                                    <ComboBoxItem Content="日语" Tag="ja" />
                                                </ComboBox>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="翻译" Style="{StaticResource FieldLabelText}" />
                                                <ui:ToggleSwitch x:Name="TranslationEnabledSwitch"
                                                                 AutomationProperties.AutomationId="TranslationEnabledSwitch"
                                                                 Content="启用翻译"
                                                                 IsChecked="False"
                                                                 Checked="OnTranslationSettingChanged"
                                                                 Unchecked="OnTranslationSettingChanged" />
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="模型配置"
                                                   FontSize="13"
                                                   FontWeight="Medium"
                                                   Foreground="{StaticResource PrimaryTextBrush}" />
                                        <TextBlock x:Name="TranslationSelectionSummaryText"
                                                   AutomationProperties.AutomationId="TranslationSelectionSummaryText"
                                                   Text="尚未添加配置"
                                                   FontSize="12"
                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                   MaxWidth="360"
                                                   HorizontalAlignment="Left"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"
                                                   Margin="0,4,0,8" />

                                        <ListBox x:Name="TranslationProfileList"
                                                 AutomationProperties.AutomationId="TranslationProfileList"
                                                 MinHeight="52"
                                                 MaxHeight="176"
                                                 Margin="0,0,0,10"
                                                 BorderBrush="{StaticResource StrokeBrush}"
                                                 BorderThickness="1"
                                                 Background="Transparent"
                                                 HorizontalContentAlignment="Stretch"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 SelectionChanged="OnTranslationProfileSelectionChanged">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                    <Setter Property="Padding" Value="12,9" />
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="28" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <ui:SymbolIcon Symbol="Translate24" VerticalAlignment="Center" />
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Medium" />
                                                            <TextBlock Text="{Binding Endpoint}"
                                                                       FontSize="11"
                                                                       Foreground="{StaticResource SecondaryTextBrush}"
                                                                       TextWrapping="Wrap" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding ValidationStatus}"
                                                                   FontSize="12"
                                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                                   VerticalAlignment="Center"
                                                                   Margin="12,0,0,0" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>

                                        <DockPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <ui:Button Click="OnAddTranslationProfileClick"
                                                           AutomationProperties.AutomationId="AddTranslationProfileButton"
                                                           ToolTip="添加模型配置"
                                                           Width="36" Height="34" Margin="0,0,6,0">
                                                    <ui:SymbolIcon Symbol="Add24" />
                                                </ui:Button>
                                                <ui:Button x:Name="EditTranslationProfileButton"
                                                           AutomationProperties.AutomationId="EditTranslationProfileButton"
                                                           Click="OnEditTranslationProfileClick"
                                                           ToolTip="编辑选中配置"
                                                           Width="36" Height="34" Margin="0,0,6,0">
                                                    <ui:SymbolIcon Symbol="Edit24" />
                                                </ui:Button>
                                                <ui:Button x:Name="CopyTranslationProfileButton"
                                                           AutomationProperties.AutomationId="CopyTranslationProfileButton"
                                                           Click="OnCopyTranslationProfileClick"
                                                           ToolTip="复制选中配置"
                                                           Width="36" Height="34" Margin="0,0,6,0">
                                                    <ui:SymbolIcon Symbol="Copy24" />
                                                </ui:Button>
                                                <ui:Button x:Name="DeleteTranslationProfileButton"
                                                           AutomationProperties.AutomationId="DeleteTranslationProfileButton"
                                                           Click="OnDeleteTranslationProfileClick"
                                                           ToolTip="删除选中配置"
                                                           Width="36" Height="34">
                                                    <ui:SymbolIcon Symbol="Delete24" />
                                                </ui:Button>
                                            </StackPanel>
                                            <ui:Button x:Name="TestTranslationProfileButton"
                                                       AutomationProperties.AutomationId="TestTranslationProfileButton"
                                                       DockPanel.Dock="Right"
                                                       Click="OnTestTranslationProfileClick"
                                                       Height="34"
                                                       Padding="12,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="PlugConnected24" Margin="0,0,7,0" />
                                                    <TextBlock Text="测试连接" />
                                                </StackPanel>
                                            </ui:Button>
                                        </DockPanel>
                                        <TextBlock x:Name="TranslationRemoteNoticeText"
                                                   Text="当前字幕及近期上下文将发送到此 API 地址。"
                                                   Visibility="Collapsed"
                                                   FontSize="12"
                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                   Margin="0,10,0,0"
                                                   TextWrapping="Wrap" />
                                        <TextBlock x:Name="TranslationTestResultText"
                                                   Text=""
                                                   FontSize="12"
                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                   Margin="0,6,0,0"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource PanelBorder}">
                                    <StackPanel>
                                        <TextBlock Text="悬浮字幕窗"
                                                   AutomationProperties.AutomationId="SettingsFloatingGroup"
                                                   Style="{StaticResource SectionTitleText}" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="24" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,12">
                                                <TextBlock Text="字号" Style="{StaticResource FieldLabelText}" />
                                                <ui:NumberBox x:Name="FloatingFontSizeBox"
                                                              Value="18"
                                                              Minimum="12"
                                                              Maximum="72"
                                                              SmallChange="1"
                                                              LargeChange="4"
                                                              Width="180"
                                                              HorizontalAlignment="Left" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,12">
                                                <TextBlock Text="显示字幕数" Style="{StaticResource FieldLabelText}" />
                                                <ui:NumberBox x:Name="FloatingLinesBox"
                                                              Value="2"
                                                              Minimum="1"
                                                              Maximum="3"
                                                              SmallChange="1"
                                                              LargeChange="1"
                                                              Width="180"
                                                              HorizontalAlignment="Left" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="0">
                                                <TextBlock Text="透明度" Style="{StaticResource FieldLabelText}" />
                                                <Slider x:Name="FloatingOpacitySlider"
                                                        Minimum="0.35"
                                                        Maximum="0.95"
                                                        Value="0.72"
                                                        Width="260"
                                                        HorizontalAlignment="Left" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                                                <ui:Button Click="OnShowFloatingWindowClick" Margin="0,0,8,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <ui:SymbolIcon Symbol="Window24" Margin="0,0,8,0" />
                                                        <TextBlock Text="显示/隐藏" />
                                                    </StackPanel>
                                                </ui:Button>
                                                <ui:Button Click="OnToggleFloatingLockClick">
                                                    <StackPanel Orientation="Horizontal">
                                                        <ui:SymbolIcon Symbol="LockClosed24" Margin="0,0,8,0" />
                                                        <TextBlock Text="锁定/解锁" />
                                                    </StackPanel>
                                                </ui:Button>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource PanelBorder}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="快捷键"
                                                       AutomationProperties.AutomationId="SettingsDiagnosticsGroup"
                                                       Style="{StaticResource SectionTitleText}" />
                                            <ui:ToggleSwitch x:Name="HotkeysEnabledSwitch"
                                                             Content="启用全局快捷键"
                                                             IsChecked="True" />
                                            <TextBlock Text="Ctrl+Alt+S 开始/停止，Ctrl+Alt+H 隐藏/显示，Ctrl+Alt+L 锁定/解锁"
                                                       Foreground="{StaticResource SecondaryTextBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,6,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="诊断" Style="{StaticResource SectionTitleText}" />
                                            <ui:ToggleSwitch x:Name="DiagnosticsSwitch"
                                                             Content="诊断模式" />
                                            <TextBlock Text="开启后保存分段音频和 VAD 时间线"
                                                       Foreground="{StaticResource SecondaryTextBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,6,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <Grid x:Name="AboutPage" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="关于" FontSize="24" FontWeight="Medium" Margin="0,0,0,18" />
                                <Border Style="{StaticResource PanelBorder}">
                                    <StackPanel>
                                        <TextBlock Text="StreamTranslator V1.2" Style="{StaticResource SectionTitleText}" />
                                        <TextBlock x:Name="DataDirectoryText"
                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,14" />
                                        <StackPanel Orientation="Horizontal">
                                            <ui:Button Click="OnOpenDataDirectoryClick" Margin="0,0,8,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="Folder24" Margin="0,0,8,0" />
                                                    <TextBlock Text="打开数据目录" />
                                                </StackPanel>
                                            </ui:Button>
                                            <ui:Button Click="OnOpenLogsDirectoryClick" Margin="0,0,8,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="Folder24" Margin="0,0,8,0" />
                                                    <TextBlock Text="打开日志目录" />
                                                </StackPanel>
                                            </ui:Button>
                                            <ui:Button Click="OnCopyDiagnosticsClick">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="Copy24" Margin="0,0,8,0" />
                                                    <TextBlock Text="复制诊断信息" />
                                                </StackPanel>
                                            </ui:Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </ui:NavigationView.ContentOverlay>
        </ui:NavigationView>
        <ui:ContentDialogHost x:Name="RootContentDialogHost" Grid.RowSpan="2" />
        <ui:SnackbarPresenter x:Name="RootSnackbarPresenter"
                              Grid.RowSpan="2"
                              Panel.ZIndex="20"
                              AutomationProperties.AutomationId="RootSnackbarPresenter"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Bottom"
                              Margin="24,0,24,28" />
    </Grid>
</ui:FluentWindow>
