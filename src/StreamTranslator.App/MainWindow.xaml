<ui:FluentWindow x:Class="StreamTranslator.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="StreamTranslator"
                 Width="1120"
                 Height="760"
                 MinWidth="960"
                 MinHeight="640"
                 ResizeMode="CanResize"
                 WindowStartupLocation="CenterScreen"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 ExtendsContentIntoTitleBar="True"
                 Background="Transparent"
                 Loaded="OnLoaded"
                 Closing="OnClosing">
    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="AppTitleBar"
                     Grid.Row="0"
                     Title=""
                     Height="48"
                     ShowMinimize="True"
                     ShowMaximize="True"
                     ShowClose="True"
                     ForceShutdown="False">
            <ui:TitleBar.Header>
                <TextBlock Text="StreamTranslator"
                           AutomationProperties.AutomationId="TitleBarAppTitle"
                           Style="{StaticResource TitleBarTitleText}"
                           Margin="16,0,0,0" />
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <ui:NavigationView x:Name="MainNavigation"
                           Grid.Row="1"
                           AutomationProperties.AutomationId="MainNavigation"
                           PaneDisplayMode="LeftFluent"
                           IsPaneOpen="True"
                           IsPaneToggleVisible="False"
                           IsBackButtonVisible="Collapsed"
                           HeaderVisibility="Collapsed"
                           AlwaysShowHeader="False"
                           Background="Transparent">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="主页"
                                       Tag="HomePage"
                                       AutomationProperties.AutomationId="NavHomePage"
                                       AutomationProperties.ItemStatus="Active"
                                       Style="{StaticResource NavItemStyle}"
                                       Click="OnNavClick"
                                       IsActive="True">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Home24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="字幕历史"
                                       Tag="SubtitleHistoryPage"
                                       AutomationProperties.AutomationId="NavSubtitleHistoryPage"
                                       AutomationProperties.ItemStatus="Inactive"
                                       Style="{StaticResource NavItemStyle}"
                                       Click="OnNavClick">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="ClosedCaption24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="设置"
                                       Tag="SettingsPage"
                                       AutomationProperties.AutomationId="NavSettingsPage"
                                       AutomationProperties.ItemStatus="Inactive"
                                       Style="{StaticResource NavItemStyle}"
                                       Click="OnNavClick">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Settings24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="关于"
                                       Tag="AboutPage"
                                       AutomationProperties.AutomationId="NavAboutPage"
                                       AutomationProperties.ItemStatus="Inactive"
                                       Style="{StaticResource NavItemStyle}"
                                       Click="OnNavClick">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Info24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.FooterMenuItems>

            <ui:NavigationView.ContentOverlay>
                <Grid>
                    <Grid x:Name="HomePage">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="32,24,32,32">
                                <DockPanel Margin="0,0,0,16">
                                    <TextBlock Text="实时字幕"
                                               Style="{StaticResource PageTitleText}"
                                               VerticalAlignment="Center" />
                                    <Border x:Name="HomeStateBadge"
                                            DockPanel.Dock="Right"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="12,5">
                                        <TextBlock x:Name="HomeStateBadgeText"
                                                   Text="就绪"
                                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold" />
                                    </Border>
                                </DockPanel>

                                <!-- 不用 ui:InfoBar：其模板在 IsOpen=False 初始布局时的
                                     BorderBrush Storyboard 会抛 InvalidOperationException。 -->
                                <Border x:Name="ApiKeyGuidanceBar"
                                        AutomationProperties.AutomationId="ApiKeyGuidanceBar"
                                        Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="16,12"
                                        Margin="0,0,0,16"
                                        Visibility="Collapsed">
                                    <DockPanel>
                                        <ui:SymbolIcon Symbol="Info24"
                                                       DockPanel.Dock="Left"
                                                       Margin="0,2,12,0"
                                                       VerticalAlignment="Top"
                                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                        <ui:Button DockPanel.Dock="Right"
                                                   Content="前往设置"
                                                   AutomationProperties.AutomationId="ApiKeyGuidanceSettingsButton"
                                                   Icon="{ui:SymbolIcon Settings24}"
                                                   Click="OnGoToSettingsClick"
                                                   Margin="16,0,0,0"
                                                   VerticalAlignment="Center" />
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="尚未配置识别服务"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                            <TextBlock Text="开始字幕前，请先在“设置 → 识别服务”中填写 API Key。"
                                                       Style="{StaticResource CaptionText}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <Border x:Name="HomeControlBar"
                                        Style="{StaticResource PanelBorder}">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,20">
                                            <TextBlock Text="字幕概览"
                                                       AutomationProperties.AutomationId="HomeOverviewPanel"
                                                       Style="{StaticResource SectionTitleText}"
                                                       Margin="0"
                                                       VerticalAlignment="Center" />
                                            <StackPanel DockPanel.Dock="Right"
                                                        Orientation="Horizontal"
                                                        HorizontalAlignment="Right">
                                                <ui:Button x:Name="StartStopButton"
                                                           AutomationProperties.AutomationId="StartStopButton"
                                                           Appearance="Primary"
                                                           Click="OnStartStopClick"
                                                           MinWidth="116"
                                                           Margin="0,0,8,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <ui:ProgressRing x:Name="StartStopProgressRing"
                                                                         IsIndeterminate="True"
                                                                         Width="16"
                                                                         Height="16"
                                                                         Margin="0,0,8,0"
                                                                         Visibility="Collapsed" />
                                                        <ui:SymbolIcon x:Name="StartStopIcon" Symbol="Play24" Margin="0,0,8,0" />
                                                        <TextBlock x:Name="StartStopText" Text="开始字幕" />
                                                    </StackPanel>
                                                </ui:Button>
                                                <ui:Button x:Name="HomeFloatingWindowButton"
                                                           AutomationProperties.AutomationId="HomeFloatingWindowButton"
                                                           AutomationProperties.Name="显示悬浮窗"
                                                           Click="OnShowFloatingWindowClick"
                                                           MinWidth="112">
                                                    <StackPanel Orientation="Horizontal">
                                                        <ui:SymbolIcon x:Name="FloatingWindowIcon" Symbol="Window24" Margin="0,0,8,0" />
                                                        <TextBlock Text="悬浮窗" />
                                                    </StackPanel>
                                                </ui:Button>
                                            </StackPanel>
                                        </DockPanel>

                                        <Grid Margin="0,0,0,24">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="24" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="24" />
                                                <ColumnDefinition Width="300" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="当前状态" Style="{StaticResource FieldLabelText}" />
                                                <TextBlock x:Name="HomeRuntimeSummaryText"
                                                           AutomationProperties.AutomationId="HomeControlBar"
                                                           Text="未启动，等待开始"
                                                           Style="{StaticResource FieldValueText}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="输出设备" Style="{StaticResource FieldLabelText}" />
                                                <TextBlock x:Name="CurrentAudioDeviceText"
                                                           AutomationProperties.AutomationId="HomeAudioDeviceText"
                                                           Text="默认设备"
                                                           FontSize="14"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="4">
                                                <DockPanel Margin="0,0,0,8">
                                                    <TextBlock Text="输入电平" Style="{StaticResource FieldLabelText}" Margin="0" />
                                                    <TextBlock x:Name="HomeAudioLevelText"
                                                               DockPanel.Dock="Right"
                                                               Text="0%"
                                                               Style="{StaticResource CaptionText}"
                                                               HorizontalAlignment="Right" />
                                                </DockPanel>
                                                <ProgressBar x:Name="AudioLevelBar"
                                                             AutomationProperties.AutomationId="HomeAudioLevelBar"
                                                             AutomationProperties.Name="输入电平"
                                                             Minimum="0"
                                                             Maximum="100"
                                                             Height="8" />
                                            </StackPanel>
                                        </Grid>

                                        <Border Height="1"
                                                Background="{DynamicResource DividerStrokeColorDefaultBrush}"
                                                Margin="0,0,0,20" />

                                        <TextBlock Text="运行链路"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   Margin="0,0,0,12" />
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="20" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <StackPanel Grid.Row="0" Grid.Column="0">
                                                <TextBlock Text="音频输入" Style="{StaticResource FieldLabelText}" />
                                                <TextBlock x:Name="AudioStatusText"
                                                           AutomationProperties.AutomationId="OverviewAudioInputStatus"
                                                           Text="未启动"
                                                           Style="{StaticResource FieldValueText}" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="0" Grid.Column="1">
                                                <TextBlock Text="语音检测" Style="{StaticResource FieldLabelText}" />
                                                <TextBlock x:Name="VadStatusText"
                                                           AutomationProperties.AutomationId="OverviewSpeechDetectionStatus"
                                                           Text="等待模型"
                                                           Style="{StaticResource FieldValueText}" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="0" Grid.Column="2">
                                                <TextBlock Text="识别进程" Style="{StaticResource FieldLabelText}" />
                                                <TextBlock x:Name="WorkerStatusText"
                                                           AutomationProperties.AutomationId="OverviewRecognitionWorkerStatus"
                                                           Text="未启动"
                                                           Style="{StaticResource FieldValueText}" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="0" Grid.Column="3">
                                                <TextBlock Text="识别接口" Style="{StaticResource FieldLabelText}" />
                                                <TextBlock x:Name="ApiStatusText"
                                                           AutomationProperties.AutomationId="OverviewRecognitionApiStatus"
                                                           Text="未测试"
                                                           Style="{StaticResource FieldValueText}" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="2" Grid.Column="0">
                                                <TextBlock Text="翻译进程" Style="{StaticResource FieldLabelText}" />
                                                <TextBlock x:Name="TranslationWorkerStatusText"
                                                           AutomationProperties.AutomationId="OverviewTranslationWorkerStatus"
                                                           Text="已关闭"
                                                           Style="{StaticResource FieldValueText}" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="2" Grid.Column="1">
                                                <TextBlock Text="翻译接口" Style="{StaticResource FieldLabelText}" />
                                                <TextBlock x:Name="TranslationApiStatusText"
                                                           AutomationProperties.AutomationId="OverviewTranslationApiStatus"
                                                           Text="已关闭"
                                                           Style="{StaticResource FieldValueText}" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="2" Grid.Column="2">
                                                <TextBlock Text="字幕输出" Style="{StaticResource FieldLabelText}" />
                                                <TextBlock x:Name="SubtitleOutputStatusText"
                                                           AutomationProperties.AutomationId="OverviewSubtitleOutputStatus"
                                                           Text="等待字幕"
                                                           Style="{StaticResource FieldValueText}" />
                                            </StackPanel>
                                        </Grid>

                                    </StackPanel>
                                </Border>

                                <Border x:Name="HomeIssuesCard"
                                        Style="{StaticResource PanelBorder}">
                                    <StackPanel>
                                        <TextBlock Text="问题"
                                                   AutomationProperties.AutomationId="HomeIssuesPanel"
                                                   Style="{StaticResource SectionTitleText}" />
                                        <TextBlock x:Name="LastErrorText"
                                                   Text="无"
                                                   TextWrapping="Wrap"
                                                   FontSize="14"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <TextBlock x:Name="TranslationIssueText"
                                                   AutomationProperties.AutomationId="HomeTranslationIssueText"
                                                   Visibility="Collapsed"
                                                   TextWrapping="Wrap"
                                                   FontSize="14"
                                                   Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                                   Margin="0,12,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <Grid x:Name="SubtitleHistoryPage" Visibility="Collapsed" Margin="32,24,32,32">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="字幕历史" Style="{StaticResource PageTitleText}" />
                                <TextBlock x:Name="SubtitleHistoryCopyStatusText"
                                           AutomationProperties.AutomationId="SubtitleHistoryCopyStatus"
                                           Text=""
                                           Margin="12,0,0,6"
                                           VerticalAlignment="Bottom"
                                           Style="{StaticResource CaptionText}" />
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Right"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <ui:Button AutomationProperties.AutomationId="CopySelectedSubtitleButton"
                                           Click="OnCopySelectedClick"
                                           Icon="{ui:SymbolIcon Copy24}"
                                           Content="复制选中"
                                           Margin="0,0,8,0" />
                                <ui:Button AutomationProperties.AutomationId="CopyRecentSubtitlesButton"
                                           Click="OnCopyRecentClick"
                                           Icon="{ui:SymbolIcon History24}"
                                           Content="复制最近 10 条"
                                           Margin="0,0,8,0" />
                                <ui:Button AutomationProperties.AutomationId="CopyAllSubtitlesButton"
                                           Click="OnCopyAllClick"
                                           Icon="{ui:SymbolIcon ClipboardTextLtr24}"
                                           Content="复制当天全部" />
                                <ui:Button x:Name="ClearHistoryButton"
                                           AutomationProperties.AutomationId="ClearHistoryButton"
                                           Click="OnClearHistoryClick"
                                           Icon="{ui:SymbolIcon Delete24}"
                                           Content="清空当天历史"
                                           Margin="16,0,0,0" />
                            </StackPanel>
                        </DockPanel>

                        <Border Grid.Row="1"
                                Style="{StaticResource PanelBorder}"
                                Margin="0"
                                Padding="24,20">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top"
                                           Text="今天"
                                           Style="{StaticResource SectionTitleText}" />
                                <Grid>
                                    <TextBlock x:Name="SubtitlePlaceholderText"
                                               Text="开始字幕后，这里会保存今天的字幕记录。"
                                               Margin="12,10"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               FontSize="14"
                                               IsHitTestVisible="False" />
                                    <ListBox x:Name="SubtitleList"
                                             AutomationProperties.AutomationId="SubtitleHistoryList"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             HorizontalContentAlignment="Stretch"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="{x:Type ListBoxItem}">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="Padding" Value="12,8" />
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid HorizontalAlignment="Stretch">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="64" />
                                                        <ColumnDefinition Width="12" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding GeneratedTimeText}"
                                                               FontFamily="Cascadia Mono, Consolas"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                               Margin="0,3,0,0"
                                                               VerticalAlignment="Top" />
                                                    <StackPanel Grid.Column="2" HorizontalAlignment="Stretch">
                                                        <TextBlock Text="{Binding SourceText}"
                                                                   TextWrapping="Wrap"
                                                                   FontSize="14"
                                                                   LineHeight="21"
                                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                        <TextBlock Text="{Binding TranslatedText}"
                                                                   TextWrapping="Wrap"
                                                                   FontSize="14"
                                                                   LineHeight="21"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                   Margin="0,3,0,0">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding TranslatedText}" Value="{x:Null}">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding TranslatedText}" Value="">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <Grid x:Name="SettingsPage" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="32,24,32,32">
                                <TextBlock Text="设置" Style="{StaticResource PageTitleText}" Margin="0,0,0,16" />

                                <Border Style="{StaticResource PanelBorder}">
                                    <StackPanel>
                                        <TextBlock Text="音频"
                                                   AutomationProperties.AutomationId="SettingsAudioGroup"
                                                   Style="{StaticResource SectionTitleText}" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="24" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,16">
                                                <DockPanel Margin="0,0,0,6">
                                                    <TextBlock Text="输出设备" Style="{StaticResource FieldLabelText}" Margin="0" VerticalAlignment="Center" />
                                                    <ui:Button DockPanel.Dock="Right"
                                                               AutomationProperties.AutomationId="RefreshAudioDevicesButton"
                                                               ToolTip="刷新设备列表"
                                                               Padding="4,2"
                                                               HorizontalAlignment="Right"
                                                               Appearance="Transparent"
                                                               BorderThickness="0"
                                                               Click="OnRefreshAudioDevicesClick">
                                                        <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="14" />
                                                    </ui:Button>
                                                </DockPanel>
                                                <ComboBox x:Name="AudioDeviceComboBox"
                                                          AutomationProperties.AutomationId="AudioDeviceComboBox"
                                                          SelectionChanged="OnAudioDeviceSelectionChanged" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,16">
                                                <TextBlock Text="默认设备" Style="{StaticResource FieldLabelText}" />
                                                <ui:ToggleSwitch x:Name="FollowDefaultDeviceSwitch"
                                                                 AutomationProperties.AutomationId="FollowDefaultDeviceSwitch"
                                                                 Content="跟随系统默认设备"
                                                                 IsChecked="True"
                                                                 Checked="OnAnySettingChanged"
                                                                 Unchecked="OnAnySettingChanged" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="1"
                                                        Grid.Column="0"
                                                        Grid.ColumnSpan="3"
                                                        Margin="0,0,0,16">
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="24" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Text="断句策略"
                                                               Style="{StaticResource FieldLabelText}" />
                                                    <TextBlock x:Name="CurrentVadEndpointText"
                                                               AutomationProperties.AutomationId="CurrentVadEndpointText"
                                                               Grid.Column="2"
                                                               Text="当前断句等待：400ms（均衡，自适应）"
                                                               Style="{StaticResource CaptionText}"
                                                               HorizontalAlignment="Left" />
                                                </Grid>
                                                <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        HorizontalAlignment="Left">
                                                    <Grid Width="456">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <RadioButton x:Name="LowLatencyVadModeButton"
                                                                     Grid.Column="0"
                                                                     GroupName="VadEndpointMode"
                                                                     Content="低延迟"
                                                                     Tag="LowLatency"
                                                                     AutomationProperties.AutomationId="VadModeLowLatency"
                                                                     Checked="OnVadEndpointModeChecked"
                                                                     Style="{StaticResource SegmentedOptionStyle}" />
                                                        <RadioButton x:Name="BalancedVadModeButton"
                                                                     Grid.Column="1"
                                                                     GroupName="VadEndpointMode"
                                                                     Content="均衡"
                                                                     Tag="Balanced"
                                                                     IsChecked="True"
                                                                     AutomationProperties.AutomationId="VadModeBalanced"
                                                                     Checked="OnVadEndpointModeChecked"
                                                                     Style="{StaticResource SegmentedOptionStyle}" />
                                                        <RadioButton x:Name="SentenceCompleteVadModeButton"
                                                                     Grid.Column="2"
                                                                     GroupName="VadEndpointMode"
                                                                     Content="句子完整"
                                                                     Tag="SentenceComplete"
                                                                     AutomationProperties.AutomationId="VadModeSentenceComplete"
                                                                     Checked="OnVadEndpointModeChecked"
                                                                     Style="{StaticResource SegmentedOptionStyle}" />
                                                        <RadioButton x:Name="FixedVadModeButton"
                                                                     Grid.Column="3"
                                                                     GroupName="VadEndpointMode"
                                                                     Content="固定值"
                                                                     Tag="Fixed"
                                                                     AutomationProperties.AutomationId="VadModeFixed"
                                                                     Checked="OnVadEndpointModeChecked"
                                                                     Style="{StaticResource SegmentedOptionStyle}" />
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,16">
                                                <TextBlock Text="固定断句等待 (ms)" Style="{StaticResource FieldLabelText}" />
                                                <ui:NumberBox x:Name="EndSilenceBox"
                                                              AutomationProperties.AutomationId="FixedEndSilenceBox"
                                                              Value="400"
                                                              Minimum="200"
                                                              Maximum="800"
                                                              SmallChange="50"
                                                              LargeChange="100"
                                                              Width="180"
                                                              IsEnabled="False"
                                                              ValueChanged="OnFixedEndSilenceValueChanged"
                                                              HorizontalAlignment="Left" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,16">
                                                <TextBlock Text="最短片段 (ms)" Style="{StaticResource FieldLabelText}" />
                                                <ui:NumberBox x:Name="MinSegmentBox"
                                                              Value="900"
                                                              Minimum="300"
                                                              Maximum="3000"
                                                              SmallChange="100"
                                                              LargeChange="300"
                                                              Width="180"
                                                              ValueChanged="OnNumberSettingChanged"
                                                              HorizontalAlignment="Left" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="3" Grid.Column="0">
                                                <TextBlock Text="最长片段 (ms)" Style="{StaticResource FieldLabelText}" />
                                                <ui:NumberBox x:Name="HardMaxSegmentBox"
                                                              AutomationProperties.AutomationId="HardMaxSegmentBox"
                                                              Value="10000"
                                                              Minimum="6000"
                                                              Maximum="20000"
                                                              SmallChange="1000"
                                                              LargeChange="2000"
                                                              Width="180"
                                                              ValueChanged="OnNumberSettingChanged"
                                                              HorizontalAlignment="Left" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="3" Grid.Column="2">
                                                <TextBlock Text="自适应状态" Style="{StaticResource FieldLabelText}" />
                                                <TextBlock x:Name="AdaptiveVadStatusText"
                                                           AutomationProperties.AutomationId="AdaptiveVadStatusText"
                                                           Text="等待运行"
                                                           Style="{StaticResource CaptionText}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource PanelBorder}">
                                    <StackPanel>
                                        <TextBlock Text="识别服务"
                                                   AutomationProperties.AutomationId="SettingsRecognitionGroup"
                                                   Style="{StaticResource SectionTitleText}" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="24" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,16">
                                                <TextBlock Text="API Key" Style="{StaticResource FieldLabelText}" />
                                                <ui:PasswordBox x:Name="ApiKeyBox"
                                                                PlaceholderText="输入识别服务 API Key"
                                                                LostFocus="OnAsrCredentialLostFocus" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,16">
                                                <TextBlock Text="Base URL" Style="{StaticResource FieldLabelText}" />
                                                <ui:TextBox x:Name="BaseUrlBox"
                                                            PlaceholderText="https://..."
                                                            LostFocus="OnAsrCredentialLostFocus" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,16">
                                                <TextBlock Text="Model" Style="{StaticResource FieldLabelText}" />
                                                <ui:TextBox x:Name="ModelBox" Text="mimo-v2.5-asr" LostFocus="OnAsrCredentialLostFocus" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,16">
                                                <TextBlock Text="识别语言" Style="{StaticResource FieldLabelText}" />
                                                <ui:TextBox x:Name="LanguageBox"
                                                            AutomationProperties.AutomationId="AsrLanguageBox"
                                                            Text="自动检测 (auto)"
                                                            IsReadOnly="True"
                                                            IsTabStop="False" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="2" Grid.Column="0">
                                                <TextBlock Text="请求超时 (ms)" Style="{StaticResource FieldLabelText}" />
                                                <ui:NumberBox x:Name="TimeoutBox"
                                                              Value="30000"
                                                              Minimum="5000"
                                                              Maximum="120000"
                                                              SmallChange="1000"
                                                              LargeChange="5000"
                                                              Width="180"
                                                              ValueChanged="OnNumberSettingChanged"
                                                              HorizontalAlignment="Left" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="2" Grid.Column="2">
                                                <TextBlock Text="最大并发" Style="{StaticResource FieldLabelText}" />
                                                <ui:NumberBox x:Name="MaxConcurrencyBox"
                                                              Value="2"
                                                              Minimum="1"
                                                              Maximum="4"
                                                              SmallChange="1"
                                                              LargeChange="1"
                                                              Width="180"
                                                              ValueChanged="OnNumberSettingChanged"
                                                              HorizontalAlignment="Left" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock x:Name="AsrValidationText"
                                                   AutomationProperties.AutomationId="AsrValidationText"
                                                   Visibility="Collapsed"
                                                   Style="{StaticResource CaptionText}"
                                                   Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,12,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border x:Name="TranslationSettingsPanel"
                                        Style="{StaticResource PanelBorder}">
                                    <StackPanel>
                                        <TextBlock Text="字幕翻译"
                                                   AutomationProperties.AutomationId="SettingsTranslationGroup"
                                                   Style="{StaticResource SectionTitleText}" />

                                        <Grid Margin="0,0,0,16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="24" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="目标语言" Style="{StaticResource FieldLabelText}" />
                                                <ComboBox x:Name="TranslationTargetLanguageBox"
                                                          AutomationProperties.AutomationId="TranslationTargetLanguageBox"
                                                          Width="280"
                                                          HorizontalAlignment="Left"
                                                          SelectionChanged="OnTranslationSettingChanged">
                                                    <ComboBoxItem Content="中文" Tag="zh-Hans" />
                                                    <ComboBoxItem Content="英语" Tag="en" />
                                                    <ComboBoxItem Content="德语" Tag="de" />
                                                    <ComboBoxItem Content="法语" Tag="fr" />
                                                    <ComboBoxItem Content="日语" Tag="ja" />
                                                </ComboBox>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="翻译" Style="{StaticResource FieldLabelText}" />
                                                <ui:ToggleSwitch x:Name="TranslationEnabledSwitch"
                                                                 AutomationProperties.AutomationId="TranslationEnabledSwitch"
                                                                 Content="启用翻译"
                                                                 IsChecked="False"
                                                                 Checked="OnTranslationSettingChanged"
                                                                 Unchecked="OnTranslationSettingChanged" />
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="模型配置"
                                                   FontSize="13"
                                                   FontWeight="Medium"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <TextBlock x:Name="TranslationSelectionSummaryText"
                                                   AutomationProperties.AutomationId="TranslationSelectionSummaryText"
                                                   Text="尚未添加配置"
                                                   Style="{StaticResource CaptionText}"
                                                   MaxWidth="360"
                                                   HorizontalAlignment="Left"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"
                                                   Margin="0,4,0,8" />

                                        <ListBox x:Name="TranslationProfileList"
                                                 AutomationProperties.AutomationId="TranslationProfileList"
                                                 MinHeight="52"
                                                 MaxHeight="176"
                                                 Margin="0,0,0,12"
                                                 BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                 BorderThickness="1"
                                                 Background="Transparent"
                                                 HorizontalContentAlignment="Stretch"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 SelectionChanged="OnTranslationProfileSelectionChanged">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                    <Setter Property="Padding" Value="12,9" />
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="28" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <ui:SymbolIcon Symbol="Translate24"
                                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                       VerticalAlignment="Center" />
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Medium" />
                                                            <TextBlock Text="{Binding Endpoint}"
                                                                       FontSize="11"
                                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                       TextWrapping="Wrap" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding ValidationStatus}"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                   VerticalAlignment="Center"
                                                                   Margin="12,0,0,0" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>

                                        <DockPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <ui:Button Click="OnAddTranslationProfileClick"
                                                           AutomationProperties.AutomationId="AddTranslationProfileButton"
                                                           ToolTip="添加模型配置"
                                                           Width="36" Height="36" Padding="0" Margin="0,0,8,0">
                                                    <ui:SymbolIcon Symbol="Add24" />
                                                </ui:Button>
                                                <ui:Button x:Name="EditTranslationProfileButton"
                                                           AutomationProperties.AutomationId="EditTranslationProfileButton"
                                                           Click="OnEditTranslationProfileClick"
                                                           ToolTip="编辑选中配置"
                                                           Width="36" Height="36" Padding="0" Margin="0,0,8,0">
                                                    <ui:SymbolIcon Symbol="Edit24" />
                                                </ui:Button>
                                                <ui:Button x:Name="CopyTranslationProfileButton"
                                                           AutomationProperties.AutomationId="CopyTranslationProfileButton"
                                                           Click="OnCopyTranslationProfileClick"
                                                           ToolTip="复制选中配置"
                                                           Width="36" Height="36" Padding="0" Margin="0,0,8,0">
                                                    <ui:SymbolIcon Symbol="Copy24" />
                                                </ui:Button>
                                                <ui:Button x:Name="DeleteTranslationProfileButton"
                                                           AutomationProperties.AutomationId="DeleteTranslationProfileButton"
                                                           Click="OnDeleteTranslationProfileClick"
                                                           ToolTip="删除选中配置"
                                                           Width="36" Height="36" Padding="0">
                                                    <ui:SymbolIcon Symbol="Delete24" />
                                                </ui:Button>
                                                <ui:Button x:Name="TestTranslationProfileButton"
                                                           AutomationProperties.AutomationId="TestTranslationProfileButton"
                                                           Click="OnTestTranslationProfileClick"
                                                           Icon="{ui:SymbolIcon PlugConnected24}"
                                                           Margin="16,0,0,0"
                                                           Content="测试连接" />
                                                <ui:ProgressRing x:Name="TranslationTestProgressRing"
                                                                 IsIndeterminate="True"
                                                                 Width="16"
                                                                 Height="16"
                                                                 Margin="12,0,0,0"
                                                                 VerticalAlignment="Center"
                                                                 Visibility="Collapsed" />
                                            </StackPanel>
                                        </DockPanel>
                                        <TextBlock x:Name="TranslationRemoteNoticeText"
                                                   Text="当前字幕及近期上下文将发送到此 API 地址。"
                                                   Visibility="Collapsed"
                                                   Style="{StaticResource CaptionText}"
                                                   Margin="0,12,0,0"
                                                   TextWrapping="Wrap" />
                                        <TextBlock x:Name="TranslationTestResultText"
                                                   Text=""
                                                   Style="{StaticResource CaptionText}"
                                                   Margin="0,8,0,0"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource PanelBorder}">
                                    <StackPanel>
                                        <TextBlock Text="悬浮字幕窗"
                                                   AutomationProperties.AutomationId="SettingsFloatingGroup"
                                                   Style="{StaticResource SectionTitleText}" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="24" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,16">
                                                <TextBlock Text="字号" Style="{StaticResource FieldLabelText}" />
                                                <ui:NumberBox x:Name="FloatingFontSizeBox"
                                                              Value="18"
                                                              Minimum="12"
                                                              Maximum="72"
                                                              SmallChange="1"
                                                              LargeChange="4"
                                                              Width="180"
                                                              ValueChanged="OnFloatingNumberSettingChanged"
                                                              HorizontalAlignment="Left" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,16">
                                                <TextBlock Text="显示字幕数" Style="{StaticResource FieldLabelText}" />
                                                <ui:NumberBox x:Name="FloatingLinesBox"
                                                              Value="2"
                                                              Minimum="1"
                                                              Maximum="3"
                                                              SmallChange="1"
                                                              LargeChange="1"
                                                              Width="180"
                                                              ValueChanged="OnFloatingNumberSettingChanged"
                                                              HorizontalAlignment="Left" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="0">
                                                <DockPanel Width="260" HorizontalAlignment="Left" Margin="0,0,0,6">
                                                    <TextBlock Text="透明度" Style="{StaticResource FieldLabelText}" Margin="0" />
                                                    <TextBlock x:Name="FloatingOpacityValueText"
                                                               DockPanel.Dock="Right"
                                                               Text="72%"
                                                               Style="{StaticResource CaptionText}"
                                                               HorizontalAlignment="Right" />
                                                </DockPanel>
                                                <Slider x:Name="FloatingOpacitySlider"
                                                        Minimum="0.35"
                                                        Maximum="0.95"
                                                        Value="0.72"
                                                        Width="260"
                                                        ValueChanged="OnFloatingOpacityChanged"
                                                        HorizontalAlignment="Left" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                                                <ui:Button Click="OnShowFloatingWindowClick"
                                                           Icon="{ui:SymbolIcon Window24}"
                                                           Content="显示/隐藏"
                                                           Margin="0,0,8,0" />
                                                <ui:Button x:Name="FloatingLockButton"
                                                           AutomationProperties.AutomationId="FloatingLockButton"
                                                           Click="OnToggleFloatingLockClick"
                                                           Icon="{ui:SymbolIcon LockClosed24}"
                                                           Content="锁定悬浮窗" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource PanelBorder}">
                                    <StackPanel>
                                        <TextBlock Text="外观"
                                                   AutomationProperties.AutomationId="SettingsAppearanceGroup"
                                                   Style="{StaticResource SectionTitleText}" />
                                        <TextBlock Text="主题" Style="{StaticResource FieldLabelText}" />
                                        <ComboBox x:Name="ThemeModeComboBox"
                                                  AutomationProperties.AutomationId="ThemeModeComboBox"
                                                  Width="220"
                                                  HorizontalAlignment="Left"
                                                  SelectionChanged="OnThemeModeChanged">
                                            <ComboBoxItem Content="跟随系统" Tag="System" />
                                            <ComboBoxItem Content="亮色" Tag="Light" />
                                            <ComboBoxItem Content="暗色" Tag="Dark" />
                                        </ComboBox>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource PanelBorder}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="快捷键"
                                                       AutomationProperties.AutomationId="SettingsDiagnosticsGroup"
                                                       Style="{StaticResource SectionTitleText}" />
                                            <ui:ToggleSwitch x:Name="HotkeysEnabledSwitch"
                                                             Content="启用全局快捷键"
                                                             IsChecked="True"
                                                             Checked="OnAnySettingChanged"
                                                             Unchecked="OnAnySettingChanged" />
                                            <TextBlock Text="Ctrl+Alt+S 开始/停止，Ctrl+Alt+H 隐藏/显示，Ctrl+Alt+L 锁定/解锁"
                                                       Style="{StaticResource CaptionText}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,8,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="诊断" Style="{StaticResource SectionTitleText}" />
                                            <ui:ToggleSwitch x:Name="DiagnosticsSwitch"
                                                             Content="诊断模式"
                                                             Checked="OnAnySettingChanged"
                                                             Unchecked="OnAnySettingChanged" />
                                            <TextBlock Text="开启后保存分段音频和 VAD 时间线"
                                                       Style="{StaticResource CaptionText}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,8,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <Grid x:Name="AboutPage" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="32,24,32,32">
                                <TextBlock Text="关于" Style="{StaticResource PageTitleText}" Margin="0,0,0,16" />
                                <Border Style="{StaticResource PanelBorder}">
                                    <StackPanel>
                                        <TextBlock x:Name="AboutVersionText"
                                                   Text="StreamTranslator"
                                                   Style="{StaticResource SectionTitleText}" />
                                        <TextBlock x:Name="DataDirectoryText"
                                                   Style="{StaticResource CaptionText}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,16" />
                                        <StackPanel Orientation="Horizontal">
                                            <ui:Button Click="OnOpenDataDirectoryClick"
                                                       Icon="{ui:SymbolIcon Folder24}"
                                                       Content="打开数据目录"
                                                       Margin="0,0,8,0" />
                                            <ui:Button Click="OnOpenLogsDirectoryClick"
                                                       Icon="{ui:SymbolIcon Folder24}"
                                                       Content="打开日志目录"
                                                       Margin="0,0,8,0" />
                                            <ui:Button Click="OnCopyDiagnosticsClick"
                                                       Icon="{ui:SymbolIcon Copy24}"
                                                       Content="复制诊断信息" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </ui:NavigationView.ContentOverlay>
        </ui:NavigationView>
        <ui:ContentDialogHost x:Name="RootContentDialogHost" Grid.RowSpan="2" />
        <ui:SnackbarPresenter x:Name="RootSnackbarPresenter"
                              Grid.RowSpan="2"
                              Panel.ZIndex="20"
                              AutomationProperties.AutomationId="RootSnackbarPresenter"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Bottom"
                              Margin="24,0,24,28" />
        <Border x:Name="ClosingOverlay"
                AutomationProperties.AutomationId="ClosingOverlay"
                Grid.RowSpan="2"
                Panel.ZIndex="40"
                Background="#66000000"
                Visibility="Collapsed">
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="32,24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <ui:ProgressRing IsIndeterminate="True"
                                     Width="24"
                                     Height="24"
                                     Margin="0,0,12,0" />
                    <TextBlock Text="正在停止字幕并保存设置…"
                               FontSize="14"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</ui:FluentWindow>
