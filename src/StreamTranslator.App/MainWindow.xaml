<ui:FluentWindow x:Class="StreamTranslator.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:controls="clr-namespace:StreamTranslator.App.Controls"
                 Title="StreamTranslator"
                 Icon="pack://application:,,,/Assets/app.ico"
                 Width="1120"
                 Height="760"
                 MinWidth="960"
                 MinHeight="640"
                 ResizeMode="CanResize"
                 WindowStartupLocation="CenterScreen"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 ExtendsContentIntoTitleBar="True"
                 Background="Transparent"
                 Loaded="OnLoaded"
                 Closing="OnClosing">
    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="AppTitleBar"
                     Grid.Row="0"
                     Title=""
                     Height="48"
                     ShowMinimize="True"
                     ShowMaximize="True"
                     ShowClose="True"
                     ForceShutdown="False">
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Image Source="pack://application:,,,/Assets/app.ico"
                           Width="18"
                           Height="18"
                           Margin="0,0,10,0"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="StreamTranslator"
                               AutomationProperties.AutomationId="TitleBarAppTitle"
                               Style="{StaticResource TitleBarTitleText}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <ui:NavigationView x:Name="MainNavigation"
                           Grid.Row="1"
                           AutomationProperties.AutomationId="MainNavigation"
                           PaneDisplayMode="LeftFluent"
                           IsPaneOpen="True"
                           IsPaneToggleVisible="False"
                           IsBackButtonVisible="Collapsed"
                           IsFooterSeparatorVisible="False"
                           HeaderVisibility="Collapsed"
                           AlwaysShowHeader="False"
                           Background="Transparent">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="主页"
                                       Tag="HomePage"
                                       AutomationProperties.AutomationId="NavHomePage"
                                       AutomationProperties.ItemStatus="Active"
                                       Style="{StaticResource NavItemStyle}"
                                       Click="OnNavClick"
                                       IsActive="True">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Home24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="字幕历史"
                                       Tag="SubtitleHistoryPage"
                                       AutomationProperties.AutomationId="NavSubtitleHistoryPage"
                                       AutomationProperties.ItemStatus="Inactive"
                                       Style="{StaticResource NavItemStyle}"
                                       Click="OnNavClick">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="ClosedCaption24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="设置"
                                       Tag="SettingsPage"
                                       AutomationProperties.AutomationId="NavSettingsPage"
                                       AutomationProperties.ItemStatus="Inactive"
                                       Style="{StaticResource NavItemStyle}"
                                       Click="OnNavClick">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Settings24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="关于"
                                       ToolTip="关于 StreamTranslator"
                                       Tag="AboutPage"
                                       AutomationProperties.AutomationId="NavAboutPage"
                                       AutomationProperties.ItemStatus="Inactive"
                                       Style="{StaticResource NavItemStyle}"
                                       Click="OnNavClick">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Info24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.FooterMenuItems>

            <ui:NavigationView.ContentOverlay>
                <Grid>
                    <Grid x:Name="HomePage">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="32,24,32,32">
                                <!-- 页头：标题 + 实时状态与断句策略摘要徽章 -->
                                <DockPanel Margin="0,0,0,16">
                                    <TextBlock Text="实时字幕"
                                               Style="{StaticResource PageTitleText}"
                                               VerticalAlignment="Center" />
                                    <Border x:Name="HomeStateBadge"
                                            DockPanel.Dock="Right"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="14"
                                            Padding="12,5">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse x:Name="HomeStateDot"
                                                     Width="8"
                                                     Height="8"
                                                     Fill="{DynamicResource AcousticIdleBrush}"
                                                     Margin="0,0,8,0"
                                                     VerticalAlignment="Center" />
                                            <TextBlock x:Name="HomeStateBadgeText"
                                                       Text="就绪"
                                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center" />
                                            <Border Width="1"
                                                    Height="11"
                                                    Background="{DynamicResource DividerStrokeColorDefaultBrush}"
                                                    Margin="8,0"
                                                    VerticalAlignment="Center" />
                                            <TextBlock x:Name="HomeVadBadgeText"
                                                       Text="均衡 400ms"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       FontSize="12"
                                                       Typography.NumeralAlignment="Tabular"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </DockPanel>

                                <!-- 不用 ui:InfoBar：其模板在 IsOpen=False 初始布局时的
                                     BorderBrush Storyboard 会抛 InvalidOperationException。 -->
                                <Border x:Name="ApiKeyGuidanceBar"
                                        AutomationProperties.AutomationId="ApiKeyGuidanceBar"
                                        Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="16,12"
                                        Margin="0,0,0,16"
                                        Visibility="Collapsed">
                                    <DockPanel>
                                        <ui:SymbolIcon Symbol="Info24"
                                                       DockPanel.Dock="Left"
                                                       Margin="0,2,12,0"
                                                       VerticalAlignment="Top"
                                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                        <ui:Button DockPanel.Dock="Right"
                                                   Content="前往设置"
                                                   AutomationProperties.AutomationId="ApiKeyGuidanceSettingsButton"
                                                   Icon="{ui:SymbolIcon Settings24}"
                                                   Click="OnGoToSettingsClick"
                                                   Margin="16,0,0,0"
                                                   VerticalAlignment="Center" />
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="尚未配置识别服务"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                            <TextBlock Text="开始字幕前，请先在“设置 → 识别服务”中填写 API Key。"
                                                       Style="{StaticResource CaptionText}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <!-- 层级一：演播控制带 (Hero Stage) -->
                                <Border x:Name="HomeControlBar"
                                        Style="{StaticResource HeroPanelBorder}">
                                    <StackPanel>
                                        <!-- 第一排：主操作按钮 + 运行状态摘要 -->
                                        <DockPanel Margin="0,0,0,18">
                                            <StackPanel DockPanel.Dock="Left"
                                                        Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <ui:Button x:Name="StartStopButton"
                                                           AutomationProperties.AutomationId="StartStopButton"
                                                           Appearance="Primary"
                                                           Click="OnStartStopClick"
                                                           Height="38"
                                                           MinWidth="132"
                                                           Padding="16,0"
                                                           Margin="0,0,10,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <ui:ProgressRing x:Name="StartStopProgressRing"
                                                                         IsIndeterminate="True"
                                                                         Width="16"
                                                                         Height="16"
                                                                         Margin="0,0,8,0"
                                                                         Visibility="Collapsed" />
                                                        <ui:SymbolIcon x:Name="StartStopIcon" Symbol="Play24" Margin="0,0,8,0" />
                                                        <TextBlock x:Name="StartStopText" Text="开始字幕" FontWeight="SemiBold" />
                                                    </StackPanel>
                                                </ui:Button>
                                                <ui:Button x:Name="HomeFloatingWindowButton"
                                                           AutomationProperties.AutomationId="HomeFloatingWindowButton"
                                                           AutomationProperties.Name="显示悬浮窗"
                                                           Click="OnShowFloatingWindowClick"
                                                           Height="38"
                                                           MinWidth="116"
                                                           Margin="0,0,8,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <ui:SymbolIcon x:Name="FloatingWindowIcon" Symbol="Window24" Margin="0,0,8,0" />
                                                        <TextBlock x:Name="HomeFloatingWindowText" Text="显示悬浮窗" />
                                                    </StackPanel>
                                                </ui:Button>
                                                <ui:Button x:Name="HomeFloatingLockButton"
                                                           AutomationProperties.AutomationId="HomeFloatingLockButton"
                                                           ToolTip="锁定或解锁悬浮窗（Ctrl+Alt+L）"
                                                           Click="OnToggleFloatingLockClick"
                                                           Height="38"
                                                           MinWidth="92">
                                                    <StackPanel Orientation="Horizontal">
                                                        <ui:SymbolIcon x:Name="HomeFloatingLockIcon" Symbol="LockClosed24" Margin="0,0,6,0" />
                                                        <TextBlock x:Name="HomeFloatingLockText" Text="锁定" />
                                                    </StackPanel>
                                                </ui:Button>
                                            </StackPanel>

                                            <StackPanel DockPanel.Dock="Right"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center"
                                                        Margin="16,0,0,0">
                                                <TextBlock x:Name="HomeRuntimeSummaryText"
                                                           AutomationProperties.AutomationId="HomeControlBar"
                                                           Text="未启动，等待开始"
                                                           FontSize="13"
                                                           FontWeight="Medium"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                           HorizontalAlignment="Right"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                                <TextBlock x:Name="HomeActiveServiceSummaryText"
                                                           Text="识别：MiMo ASR · 翻译：已关闭"
                                                           Style="{StaticResource CaptionText}"
                                                           HorizontalAlignment="Right"
                                                           Margin="0,2,0,0"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                            </StackPanel>
                                        </DockPanel>

                                        <!-- 第二排：高频快捷切换带（输出设备 + 翻译开关与目标语言） -->
                                        <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="14,10"
                                                Margin="0,0,0,18">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="14" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="14" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- 输出设备快捷选择 -->
                                                <DockPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock DockPanel.Dock="Left"
                                                               Text="输出设备"
                                                               FontSize="12"
                                                               FontWeight="Medium"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,10,0" />
                                                    <ui:Button x:Name="HomeRefreshAudioDevicesButton"
                                                               DockPanel.Dock="Right"
                                                               ToolTip="刷新音频输出设备列表"
                                                               Width="{Binding ActualHeight, ElementName=HomeAudioDeviceComboBox}"
                                                               Height="{Binding ActualHeight, ElementName=HomeAudioDeviceComboBox}"
                                                               MinWidth="34"
                                                               MinHeight="34"
                                                               Padding="0"
                                                               Margin="6,0,0,0"
                                                               VerticalAlignment="Center"
                                                               Click="OnRefreshAudioDevicesClick">
                                                        <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="14" />
                                                    </ui:Button>
                                                    <ComboBox x:Name="HomeAudioDeviceComboBox"
                                                              AutomationProperties.AutomationId="HomeAudioDeviceComboBox"
                                                              VerticalAlignment="Center"
                                                              VerticalContentAlignment="Center"
                                                              SelectionChanged="OnHomeAudioDeviceSelectionChanged" />
                                                </DockPanel>

                                                <Border Grid.Column="2"
                                                        Width="1"
                                                        Height="22"
                                                        Background="{DynamicResource DividerStrokeColorDefaultBrush}"
                                                        VerticalAlignment="Center" />

                                                <!-- 翻译快速开关与目标语言 -->
                                                <DockPanel x:Name="HomeTranslationQuickBar"
                                                           Grid.Column="4"
                                                           VerticalAlignment="Center">
                                                    <TextBlock DockPanel.Dock="Left"
                                                               Text="字幕翻译"
                                                               FontSize="12"
                                                               FontWeight="Medium"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,8,0" />
                                                    <ui:ToggleSwitch x:Name="HomeTranslationEnabledSwitch"
                                                                     AutomationProperties.AutomationId="HomeTranslationEnabledSwitch"
                                                                     DockPanel.Dock="Left"
                                                                     OffContent="关"
                                                                     OnContent="开"
                                                                     Margin="0,0,8,0"
                                                                     VerticalAlignment="Center"
                                                                     Checked="OnHomeTranslationEnabledChanged"
                                                                     Unchecked="OnHomeTranslationEnabledChanged" />
                                                    <ComboBox x:Name="HomeTranslationTargetLanguageBox"
                                                              AutomationProperties.AutomationId="HomeTranslationTargetLanguageBox"
                                                              MinWidth="122"
                                                              VerticalAlignment="Center"
                                                              VerticalContentAlignment="Center"
                                                              SelectionChanged="OnHomeTranslationTargetLanguageChanged">
                                                        <ComboBoxItem Content="译为 中文" Tag="zh-Hans" />
                                                        <ComboBoxItem Content="译为 英语" Tag="en" />
                                                        <ComboBoxItem Content="译为 德语" Tag="de" />
                                                        <ComboBoxItem Content="译为 法语" Tag="fr" />
                                                        <ComboBoxItem Content="译为 日语" Tag="ja" />
                                                    </ComboBox>
                                                </DockPanel>
                                            </Grid>
                                        </Border>

                                        <!-- 保留 CurrentAudioDeviceText 供现有逻辑与 UIA 自动化兼容 -->
                                        <TextBlock x:Name="CurrentAudioDeviceText"
                                                   AutomationProperties.AutomationId="HomeAudioDeviceText"
                                                   Text="默认设备"
                                                   Height="0"
                                                   Opacity="0"
                                                   IsHitTestVisible="False" />

                                        <!-- 第三排：分段 LED 声学电平仪 + 实时人声/识别状态灯 -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="输入电平"
                                                       FontSize="12"
                                                       FontWeight="Medium"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,12,0" />

                                            <Grid Grid.Column="1" VerticalAlignment="Center">
                                                <controls:SegmentedLevelMeter x:Name="AudioLevelMeter"
                                                                              Height="14"
                                                                              SegmentCount="32"
                                                                              InactiveBrush="{DynamicResource AcousticMeterTrackBrush}"
                                                                              NormalBrush="{DynamicResource AcousticLiveBrush}"
                                                                              WarmBrush="{DynamicResource AcousticWarmBrush}"
                                                                              PeakBrush="{DynamicResource AcousticPeakBrush}" />
                                                <!-- 保留 ProgressBar 隐藏于底层，保持 HomeAudioLevelBar 的 UIA 契约 -->
                                                <ProgressBar x:Name="AudioLevelBar"
                                                             AutomationProperties.AutomationId="HomeAudioLevelBar"
                                                             AutomationProperties.Name="输入电平"
                                                             Minimum="0"
                                                             Maximum="100"
                                                             Height="1"
                                                             Opacity="0"
                                                             IsHitTestVisible="False" />
                                            </Grid>

                                            <TextBlock x:Name="HomeAudioLevelText"
                                                       Grid.Column="2"
                                                       Text="0%"
                                                       Width="40"
                                                       TextAlignment="Right"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Typography.NumeralAlignment="Tabular"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                       VerticalAlignment="Center"
                                                       Margin="10,0,12,0" />

                                            <Border x:Name="HomeVoiceActivityBadge"
                                                    Grid.Column="3"
                                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="10"
                                                    Padding="9,3"
                                                    VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Ellipse x:Name="HomeVoiceActivityDot"
                                                             Width="7"
                                                             Height="7"
                                                             Fill="{DynamicResource AcousticIdleBrush}"
                                                             Margin="0,0,6,0"
                                                             VerticalAlignment="Center" />
                                                    <TextBlock x:Name="HomeVoiceActivityText"
                                                               Text="未监听"
                                                               FontSize="11.5"
                                                               FontWeight="Medium"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- 层级二：5 节点横向运行链路条 (Pipeline Strip) -->
                                <Border Style="{StaticResource PanelBorder}" Padding="20,16">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,12">
                                            <TextBlock Text="运行链路"
                                                       AutomationProperties.AutomationId="HomeOverviewPanel"
                                                       Style="{StaticResource SectionTitleText}"
                                                       Margin="0"
                                                       VerticalAlignment="Center" />
                                            <TextBlock x:Name="HomePipelineHintText"
                                                       DockPanel.Dock="Right"
                                                       Text="音频捕获 → VAD 断句 → 语音识别 → 字幕翻译 → 字幕输出"
                                                       Style="{StaticResource CaptionText}"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center" />
                                        </DockPanel>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- 节点 1：音频捕获 -->
                                            <Border x:Name="PipelineNodeAudio"
                                                    Grid.Column="0"
                                                    Style="{StaticResource PipelineNodeBorder}">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                        <Ellipse x:Name="PipelineDotAudio"
                                                                 Width="7"
                                                                 Height="7"
                                                                 Fill="{DynamicResource AcousticIdleBrush}"
                                                                 Margin="0,0,6,0"
                                                                 VerticalAlignment="Center" />
                                                        <TextBlock Text="音频捕获"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                    </StackPanel>
                                                    <TextBlock x:Name="AudioStatusText"
                                                               AutomationProperties.AutomationId="OverviewAudioInputStatus"
                                                               Text="未启动"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                                </StackPanel>
                                            </Border>

                                            <ui:SymbolIcon Grid.Column="1"
                                                           Symbol="ChevronRight16"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />

                                            <!-- 节点 2：VAD 断句 -->
                                            <Border x:Name="PipelineNodeVad"
                                                    Grid.Column="2"
                                                    Style="{StaticResource PipelineNodeBorder}">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                        <Ellipse x:Name="PipelineDotVad"
                                                                 Width="7"
                                                                 Height="7"
                                                                 Fill="{DynamicResource AcousticIdleBrush}"
                                                                 Margin="0,0,6,0"
                                                                 VerticalAlignment="Center" />
                                                        <TextBlock Text="VAD 断句"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                    </StackPanel>
                                                    <TextBlock x:Name="VadStatusText"
                                                               AutomationProperties.AutomationId="OverviewSpeechDetectionStatus"
                                                               Text="等待模型"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                                </StackPanel>
                                            </Border>

                                            <ui:SymbolIcon Grid.Column="3"
                                                           Symbol="ChevronRight16"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />

                                            <!-- 节点 3：语音识别 (进程 + 接口合并呈现，保留两个独立 AutomationId) -->
                                            <Border x:Name="PipelineNodeAsr"
                                                    Grid.Column="4"
                                                    Style="{StaticResource PipelineNodeBorder}">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                        <Ellipse x:Name="PipelineDotAsr"
                                                                 Width="7"
                                                                 Height="7"
                                                                 Fill="{DynamicResource AcousticIdleBrush}"
                                                                 Margin="0,0,6,0"
                                                                 VerticalAlignment="Center" />
                                                        <TextBlock Text="语音识别"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                    </StackPanel>
                                                    <TextBlock x:Name="WorkerStatusText"
                                                               AutomationProperties.AutomationId="OverviewRecognitionWorkerStatus"
                                                               Text="未启动"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                                    <TextBlock x:Name="ApiStatusText"
                                                               AutomationProperties.AutomationId="OverviewRecognitionApiStatus"
                                                               Text="未测试"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               Margin="0,2,0,0"
                                                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                                </StackPanel>
                                            </Border>

                                            <ui:SymbolIcon Grid.Column="5"
                                                           Symbol="ChevronRight16"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />

                                            <!-- 节点 4：字幕翻译 (进程 + 接口合并呈现，保留两个独立 AutomationId) -->
                                            <Border x:Name="PipelineNodeTranslation"
                                                    Grid.Column="6"
                                                    Style="{StaticResource PipelineNodeBorder}">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                        <Ellipse x:Name="PipelineDotTranslation"
                                                                 Width="7"
                                                                 Height="7"
                                                                 Fill="{DynamicResource AcousticIdleBrush}"
                                                                 Margin="0,0,6,0"
                                                                 VerticalAlignment="Center" />
                                                        <TextBlock Text="字幕翻译"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                    </StackPanel>
                                                    <TextBlock x:Name="TranslationWorkerStatusText"
                                                               AutomationProperties.AutomationId="OverviewTranslationWorkerStatus"
                                                               Text="已关闭"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                                    <TextBlock x:Name="TranslationApiStatusText"
                                                               AutomationProperties.AutomationId="OverviewTranslationApiStatus"
                                                               Text="已关闭"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               Margin="0,2,0,0"
                                                               Typography.NumeralAlignment="Tabular"
                                                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                                </StackPanel>
                                            </Border>

                                            <ui:SymbolIcon Grid.Column="7"
                                                           Symbol="ChevronRight16"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />

                                            <!-- 节点 5：字幕输出 -->
                                            <Border x:Name="PipelineNodeOutput"
                                                    Grid.Column="8"
                                                    Style="{StaticResource PipelineNodeBorder}">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                        <Ellipse x:Name="PipelineDotOutput"
                                                                 Width="7"
                                                                 Height="7"
                                                                 Fill="{DynamicResource AcousticIdleBrush}"
                                                                 Margin="0,0,6,0"
                                                                 VerticalAlignment="Center" />
                                                        <TextBlock Text="字幕输出"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                    </StackPanel>
                                                    <TextBlock x:Name="SubtitleOutputStatusText"
                                                               AutomationProperties.AutomationId="OverviewSubtitleOutputStatus"
                                                               Text="等待字幕"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- 按需显隐的问题告警横幅（正常运行时完全折叠，仅在错误或翻译降级时滑出） -->
                                <Border x:Name="HomeIssuesCard"
                                        Background="{DynamicResource AcousticPeakSoftBrush}"
                                        BorderBrush="{DynamicResource AcousticPeakBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="16,12"
                                        Margin="0,0,0,16"
                                        Visibility="Collapsed">
                                    <DockPanel>
                                        <ui:SymbolIcon x:Name="HomeIssuesIcon"
                                                       Symbol="ErrorCircle24"
                                                       DockPanel.Dock="Left"
                                                       Foreground="{DynamicResource AcousticPeakBrush}"
                                                       Margin="0,2,12,0"
                                                       VerticalAlignment="Top" />
                                        <StackPanel DockPanel.Dock="Right"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Center"
                                                    Margin="16,0,0,0">
                                            <ui:Button Content="前往设置"
                                                       Click="OnGoToSettingsClick"
                                                       Height="30"
                                                       Padding="10,0"
                                                       Margin="0,0,8,0" />
                                            <ui:Button Content="复制诊断"
                                                       Click="OnCopyDiagnosticsClick"
                                                       Height="30"
                                                       Padding="10,0"
                                                       Margin="0,0,8,0" />
                                            <ui:Button ToolTip="清除错误提示"
                                                       Click="OnDismissHomeIssueClick"
                                                       Width="30"
                                                       Height="30"
                                                       Padding="0"
                                                       Appearance="Transparent">
                                                <ui:SymbolIcon Symbol="Dismiss20" FontSize="13" />
                                            </ui:Button>
                                        </StackPanel>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="HomeIssuesTitleText"
                                                       Text="运行异常"
                                                       AutomationProperties.AutomationId="HomeIssuesPanel"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                            <TextBlock x:Name="LastErrorText"
                                                       Text="无"
                                                       TextWrapping="Wrap"
                                                       FontSize="13"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                       Margin="0,3,0,0" />
                                            <TextBlock x:Name="TranslationIssueText"
                                                       AutomationProperties.AutomationId="HomeTranslationIssueText"
                                                       Visibility="Collapsed"
                                                       TextWrapping="Wrap"
                                                       FontSize="13"
                                                       Foreground="{DynamicResource AcousticWarmBrush}"
                                                       Margin="0,4,0,0" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <!-- 层级三：实时字幕监视器（最近 4 条，单条点击直接复制，无需切页即可核对识别与翻译质量） -->
                                <Border Style="{StaticResource PanelBorder}" Padding="20,16" Margin="0">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,12">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="实时字幕监视"
                                                           Style="{StaticResource SectionTitleText}"
                                                           Margin="0"
                                                           VerticalAlignment="Center" />
                                                <TextBlock x:Name="HomeMonitorCountText"
                                                           Text="最近 4 条"
                                                           Style="{StaticResource CaptionText}"
                                                           Margin="10,0,0,0"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                            <ui:Button DockPanel.Dock="Right"
                                                       Content="查看全部历史"
                                                       Appearance="Transparent"
                                                       BorderThickness="0"
                                                       Padding="8,4"
                                                       FontSize="12"
                                                       HorizontalAlignment="Right"
                                                       Click="OnGoToHistoryClick">
                                                <ui:Button.Icon>
                                                    <ui:SymbolIcon Symbol="History20" FontSize="14" />
                                                </ui:Button.Icon>
                                            </ui:Button>
                                        </DockPanel>

                                        <Grid MinHeight="124">
                                            <StackPanel x:Name="HomeLiveMonitorEmptyState"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Center"
                                                        Margin="0,18">
                                                <TextBlock Text="等待实时字幕流"
                                                           FontSize="14"
                                                           FontWeight="Medium"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           HorizontalAlignment="Center" />
                                                <TextBlock Text="点击上方“开始字幕”后，最新识别与翻译的 4 条字幕会实时同步在这里；点击任意条目可直接复制。"
                                                           Style="{StaticResource CaptionText}"
                                                           TextAlignment="Center"
                                                           TextWrapping="Wrap"
                                                           MaxWidth="520"
                                                           Margin="0,4,0,0" />
                                            </StackPanel>

                                            <ItemsControl x:Name="HomeLiveMonitorList"
                                                          AutomationProperties.AutomationId="HomeLiveMonitorList"
                                                          Visibility="Collapsed">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                                                                BorderThickness="0,0,0,1"
                                                                CornerRadius="6"
                                                                Padding="8,9"
                                                                Cursor="Hand"
                                                                Tag="{Binding}"
                                                                ToolTip="点击复制此条字幕"
                                                                MouseLeftButtonUp="OnCopyHomeMonitorRowMouseLeftButtonUp">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="{DynamicResource SubtleFillColorTransparentBrush}" />
                                                                    <Style.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                                                        </Trigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="64" />
                                                                    <ColumnDefinition Width="12" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0"
                                                                           Text="{Binding GeneratedTimeText}"
                                                                           FontFamily="Cascadia Mono, Consolas"
                                                                           FontSize="12"
                                                                           Typography.NumeralAlignment="Tabular"
                                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                           Margin="0,2,0,0"
                                                                           VerticalAlignment="Top" />
                                                                <StackPanel Grid.Column="2">
                                                                    <TextBlock Text="{Binding SourceText}"
                                                                               TextWrapping="Wrap"
                                                                               FontSize="13.5"
                                                                               LineHeight="20"
                                                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                                    <TextBlock Text="{Binding TranslatedText}"
                                                                               TextWrapping="Wrap"
                                                                               FontSize="13.5"
                                                                               LineHeight="20"
                                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                               Margin="0,2,0,0">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding TranslatedText}" Value="{x:Null}">
                                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding TranslatedText}" Value="">
                                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </StackPanel>
                                                                <ui:Button Grid.Column="3"
                                                                           ToolTip="复制此条字幕"
                                                                           Tag="{Binding}"
                                                                           Click="OnCopyHomeMonitorItemClick"
                                                                           Appearance="Transparent"
                                                                           BorderThickness="0"
                                                                           Width="30"
                                                                           Height="30"
                                                                           Padding="0"
                                                                           Margin="8,0,0,0"
                                                                           VerticalAlignment="Top">
                                                                    <ui:SymbolIcon Symbol="Copy20" FontSize="14" />
                                                                </ui:Button>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <Grid x:Name="SubtitleHistoryPage" Visibility="Collapsed" Margin="32,24,32,32">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="字幕历史" Style="{StaticResource PageTitleText}" />
                                <TextBlock x:Name="SubtitleHistoryCopyStatusText"
                                           AutomationProperties.AutomationId="SubtitleHistoryCopyStatus"
                                           Text=""
                                           Margin="12,0,0,4"
                                           VerticalAlignment="Bottom"
                                           Style="{StaticResource CaptionText}" />
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Right"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <ui:Button AutomationProperties.AutomationId="CopySelectedSubtitleButton"
                                           Click="OnCopySelectedClick"
                                           Icon="{ui:SymbolIcon Copy24}"
                                           Content="复制选中"
                                           Margin="0,0,8,0" />
                                <ui:Button AutomationProperties.AutomationId="CopyRecentSubtitlesButton"
                                           Click="OnCopyRecentClick"
                                           Icon="{ui:SymbolIcon History24}"
                                           Content="复制最近 10 条"
                                           Margin="0,0,8,0" />
                                <ui:Button AutomationProperties.AutomationId="CopyAllSubtitlesButton"
                                           Click="OnCopyAllClick"
                                           Icon="{ui:SymbolIcon ClipboardTextLtr24}"
                                           Content="复制全部"
                                           ToolTip="复制当前列表中的全部字幕"
                                           Margin="0,0,8,0" />
                                <ui:Button x:Name="ExportSubtitlesButton"
                                           AutomationProperties.AutomationId="ExportSubtitlesButton"
                                           Click="OnExportSubtitlesClick"
                                           Icon="{ui:SymbolIcon ArrowDownload24}"
                                           Content="导出"
                                           ToolTip="导出为 SRT 字幕文件或 TXT 文本">
                                    <ui:Button.ContextMenu>
                                        <ContextMenu x:Name="ExportSubtitlesContextMenu">
                                            <MenuItem Header="导出双语字幕 (.srt)"
                                                      Tag="srt:bilingual"
                                                      Click="OnExportMenuItemClick" />
                                            <MenuItem Header="导出双语文本 (.txt)"
                                                      Tag="txt:bilingual"
                                                      Click="OnExportMenuItemClick" />
                                            <Separator />
                                            <MenuItem Header="仅导出原文 (.txt)"
                                                      Tag="txt:source"
                                                      Click="OnExportMenuItemClick" />
                                            <MenuItem Header="仅导出译文 (.txt)"
                                                      Tag="txt:translation"
                                                      Click="OnExportMenuItemClick" />
                                            <Separator />
                                            <MenuItem Header="仅导出原文 (.srt)"
                                                      Tag="srt:source"
                                                      Click="OnExportMenuItemClick" />
                                            <MenuItem Header="仅导出译文 (.srt)"
                                                      Tag="srt:translation"
                                                      Click="OnExportMenuItemClick" />
                                        </ContextMenu>
                                    </ui:Button.ContextMenu>
                                </ui:Button>
                                <ui:Button x:Name="ClearHistoryButton"
                                           AutomationProperties.AutomationId="ClearHistoryButton"
                                           Click="OnClearHistoryClick"
                                           Icon="{ui:SymbolIcon Delete24}"
                                           Content="清空"
                                           ToolTip="清空当前所选日期的字幕历史"
                                           Margin="12,0,0,0" />
                            </StackPanel>
                        </DockPanel>

                        <Border Grid.Row="1"
                                Style="{StaticResource PanelBorder}"
                                Margin="0"
                                Padding="20,16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- 历史工具条：日期切换 + 回到今天 + 条数统计 + 实时搜索 -->
                                <DockPanel Grid.Row="0" Margin="0,0,0,12">
                                    <ui:TextBox x:Name="HistorySearchBox"
                                                DockPanel.Dock="Right"
                                                AutomationProperties.AutomationId="HistorySearchBox"
                                                Width="260"
                                                PlaceholderText="搜索原文或译文..."
                                                Icon="{ui:SymbolIcon Search20}"
                                                ClearButtonEnabled="True"
                                                VerticalAlignment="Center"
                                                TextChanged="OnHistorySearchTextChanged" />

                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ComboBox x:Name="HistoryDateComboBox"
                                                  AutomationProperties.AutomationId="HistoryDateComboBox"
                                                  MinWidth="176"
                                                  VerticalContentAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  DisplayMemberPath="Label"
                                                  SelectionChanged="OnHistoryDateSelectionChanged" />
                                        <ui:Button x:Name="HistoryBackToTodayButton"
                                                   AutomationProperties.AutomationId="HistoryBackToTodayButton"
                                                   Visibility="Collapsed"
                                                   Content="回到今天"
                                                   Appearance="Secondary"
                                                   Padding="10,5"
                                                   Margin="8,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Click="OnHistoryBackToTodayClick" />
                                        <TextBlock x:Name="HistorySummaryCountText"
                                                   AutomationProperties.AutomationId="HistorySummaryCountText"
                                                   Text="暂无记录"
                                                   Style="{StaticResource CaptionText}"
                                                   Typography.NumeralAlignment="Tabular"
                                                   VerticalAlignment="Center"
                                                   Margin="12,0,12,0" />
                                    </StackPanel>
                                </DockPanel>

                                <Border Grid.Row="1"
                                        Height="1"
                                        Background="{DynamicResource DividerStrokeColorDefaultBrush}"
                                        Margin="0,0,0,10" />

                                <Grid Grid.Row="2">
                                    <TextBlock x:Name="SubtitlePlaceholderText"
                                               Text="开始字幕后，这里会保存今天的字幕记录。"
                                               Margin="12,12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               FontSize="14"
                                               IsHitTestVisible="False" />
                                    <ListBox x:Name="SubtitleList"
                                             AutomationProperties.AutomationId="SubtitleHistoryList"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             HorizontalContentAlignment="Stretch"
                                             VirtualizingStackPanel.IsVirtualizing="True"
                                             VirtualizingStackPanel.VirtualizationMode="Recycling"
                                             VirtualizingStackPanel.ScrollUnit="Pixel"
                                             ScrollViewer.CanContentScroll="True"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             ScrollViewer.ScrollChanged="OnSubtitleListScrollChanged">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="{x:Type ListBoxItem}">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="Padding" Value="12,9" />
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid HorizontalAlignment="Stretch">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="64" />
                                                        <ColumnDefinition Width="12" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding GeneratedTimeText}"
                                                               Typography.NumeralAlignment="Tabular"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                               Margin="0,3,0,0"
                                                               VerticalAlignment="Top" />
                                                    <StackPanel Grid.Column="2" HorizontalAlignment="Stretch">
                                                        <TextBlock Text="{Binding SourceText}"
                                                                   TextWrapping="Wrap"
                                                                   FontSize="14"
                                                                   LineHeight="21"
                                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                        <TextBlock Text="{Binding TranslatedText}"
                                                                   TextWrapping="Wrap"
                                                                   FontSize="13.5"
                                                                   LineHeight="20"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                   Margin="0,3,0,0">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding TranslatedText}" Value="{x:Null}">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding TranslatedText}" Value="">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <ui:Button Grid.Column="3"
                                                               Tag="{Binding}"
                                                               ToolTip="复制此条字幕"
                                                               Click="OnCopyHistoryItemClick"
                                                               Appearance="Transparent"
                                                               BorderThickness="0"
                                                               Width="30"
                                                               Height="30"
                                                               Padding="0"
                                                               Margin="8,0,0,0"
                                                               VerticalAlignment="Top">
                                                        <ui:Button.Style>
                                                            <Style TargetType="{x:Type ui:Button}" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                                <Setter Property="Opacity" Value="0.24" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                                        <Setter Property="Opacity" Value="1" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                                        <Setter Property="Opacity" Value="0.9" />
                                                                    </DataTrigger>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Opacity" Value="1" />
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ui:Button.Style>
                                                        <ui:SymbolIcon Symbol="Copy20" FontSize="14" />
                                                    </ui:Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <!-- 滚动锁定时的新字幕/回顶浮动胶囊 -->
                                    <ui:Button x:Name="HistoryJumpLatestButton"
                                               AutomationProperties.AutomationId="HistoryJumpLatestButton"
                                               Visibility="Collapsed"
                                               Appearance="Primary"
                                               CornerRadius="16"
                                               Padding="14,6"
                                               Margin="0,8,0,0"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Top"
                                               Icon="{ui:SymbolIcon ArrowUp16}"
                                               Content="回到最新"
                                               Click="OnHistoryJumpLatestClick" />
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid x:Name="SettingsPage" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 顶部固定页头 + 4 分段标签切换栏 -->
                        <StackPanel Grid.Row="0" Margin="32,24,32,12">
                            <DockPanel Margin="0,0,0,14">
                                <TextBlock Text="设置"
                                           Style="{StaticResource PageTitleText}"
                                           VerticalAlignment="Center" />
                                <TextBlock x:Name="SettingsActiveTabHintText"
                                           DockPanel.Dock="Right"
                                           Text="配置语音识别服务与字幕翻译模型"
                                           Style="{StaticResource CaptionText}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center" />
                            </DockPanel>

                            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="2"
                                    HorizontalAlignment="Left">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="112" />
                                        <ColumnDefinition Width="Auto" MinWidth="112" />
                                        <ColumnDefinition Width="Auto" MinWidth="112" />
                                        <ColumnDefinition Width="Auto" MinWidth="92" />
                                    </Grid.ColumnDefinitions>
                                    <RadioButton x:Name="SettingsTabServicesButton"
                                                 Grid.Column="0"
                                                 GroupName="SettingsSectionTab"
                                                 Content="服务与翻译"
                                                 Tag="Services"
                                                 IsChecked="True"
                                                 AutomationProperties.AutomationId="SettingsTabServicesButton"
                                                 Checked="OnSettingsTabChecked"
                                                 Style="{StaticResource SegmentedOptionStyle}" />
                                    <RadioButton x:Name="SettingsTabAudioButton"
                                                 Grid.Column="1"
                                                 GroupName="SettingsSectionTab"
                                                 Content="音频与断句"
                                                 Tag="Audio"
                                                 AutomationProperties.AutomationId="SettingsTabAudioButton"
                                                 Checked="OnSettingsTabChecked"
                                                 Style="{StaticResource SegmentedOptionStyle}" />
                                    <RadioButton x:Name="SettingsTabFloatingButton"
                                                 Grid.Column="2"
                                                 GroupName="SettingsSectionTab"
                                                 Content="悬浮窗外观"
                                                 Tag="Floating"
                                                 AutomationProperties.AutomationId="SettingsTabFloatingButton"
                                                 Checked="OnSettingsTabChecked"
                                                 Style="{StaticResource SegmentedOptionStyle}" />
                                    <RadioButton x:Name="SettingsTabGeneralButton"
                                                 Grid.Column="3"
                                                 GroupName="SettingsSectionTab"
                                                 Content="通用"
                                                 Tag="General"
                                                 AutomationProperties.AutomationId="SettingsTabGeneralButton"
                                                 Checked="OnSettingsTabChecked"
                                                 Style="{StaticResource SegmentedOptionStyle}" />
                                </Grid>
                            </Border>
                        </StackPanel>

                        <ScrollViewer x:Name="SettingsScrollViewer"
                                      Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="32,4,32,32">

                                <!-- =========================================================
                                     Tab 1：服务与翻译
                                     ========================================================= -->
                                <StackPanel x:Name="SettingsServicesPanel" Visibility="Visible">
                                    <!-- 识别服务 (ASR) -->
                                    <Border Style="{StaticResource PanelBorder}">
                                        <StackPanel>
                                            <TextBlock Text="识别服务"
                                                       AutomationProperties.AutomationId="SettingsRecognitionGroup"
                                                       Style="{StaticResource SectionTitleText}" />
                                            <TextBlock Text="服务商" Style="{StaticResource FieldLabelText}" />
                                            <ComboBox x:Name="AsrProviderBox"
                                                      AutomationProperties.AutomationId="AsrProviderBox"
                                                      Width="360"
                                                      HorizontalAlignment="Left"
                                                      VerticalContentAlignment="Center"
                                                      Margin="0,0,0,10"
                                                      SelectionChanged="OnAsrProviderChanged">
                                                <ComboBoxItem Content="MiMo ASR" Tag="Mimo" />
                                                <ComboBoxItem Content="GLM-ASR-2512（智谱 AI）" Tag="Zhipu" />
                                                <ComboBoxItem Content="DeepSeek ASR" Tag="DeepSeek" />
                                                <ComboBoxItem Content="自定义..." Tag="Custom" />
                                            </ComboBox>
                                            <TextBlock x:Name="AsrProviderInfoText"
                                                       AutomationProperties.AutomationId="AsrProviderInfoText"
                                                       Style="{StaticResource CaptionText}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,0,14" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="24" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,14">
                                                    <TextBlock Text="API Key" Style="{StaticResource FieldLabelText}" />
                                                    <ui:PasswordBox x:Name="AsrApiKeyBox"
                                                                    AutomationProperties.AutomationId="AsrApiKeyBox"
                                                                    PlaceholderText="输入服务商 API Key"
                                                                    LostFocus="OnAsrCredentialLostFocus" />
                                                </StackPanel>
                                                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,14">
                                                    <TextBlock Text="识别语言" Style="{StaticResource FieldLabelText}" />
                                                    <ui:TextBox x:Name="LanguageBox"
                                                                AutomationProperties.AutomationId="AsrLanguageBox"
                                                                Text="自动检测 (auto)"
                                                                IsReadOnly="True"
                                                                IsTabStop="False" />
                                                </StackPanel>
                                                <StackPanel x:Name="AsrCustomBaseUrlPanel"
                                                            Grid.Row="1" Grid.Column="0"
                                                            Margin="0,0,0,14"
                                                            Visibility="Collapsed">
                                                    <TextBlock Text="Base URL" Style="{StaticResource FieldLabelText}" />
                                                    <ui:TextBox x:Name="AsrCustomBaseUrlBox"
                                                                AutomationProperties.AutomationId="AsrCustomBaseUrlBox"
                                                                PlaceholderText="https://..."
                                                                LostFocus="OnAsrCredentialLostFocus" />
                                                </StackPanel>
                                                <StackPanel x:Name="AsrCustomModelPanel"
                                                            Grid.Row="1" Grid.Column="2"
                                                            Margin="0,0,0,14"
                                                            Visibility="Collapsed">
                                                    <TextBlock Text="模型名" Style="{StaticResource FieldLabelText}" />
                                                    <ui:TextBox x:Name="AsrCustomModelBox"
                                                                AutomationProperties.AutomationId="AsrCustomModelBox"
                                                                PlaceholderText="model-name"
                                                                LostFocus="OnAsrCredentialLostFocus" />
                                                </StackPanel>
                                            </Grid>

                                            <!-- ASR 连接测试条 -->
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,0,0">
                                                <ui:Button x:Name="TestAsrConnectionButton"
                                                           AutomationProperties.AutomationId="TestAsrConnectionButton"
                                                           Click="OnTestAsrConnectionClick"
                                                           Icon="{ui:SymbolIcon PlugConnected24}"
                                                           Content="测试连接" />
                                                <ui:ProgressRing x:Name="AsrTestProgressRing"
                                                                 IsIndeterminate="True"
                                                                 Width="16"
                                                                 Height="16"
                                                                 Margin="12,0,0,0"
                                                                 VerticalAlignment="Center"
                                                                 Visibility="Collapsed" />
                                                <TextBlock x:Name="AsrTestResultText"
                                                           AutomationProperties.AutomationId="AsrTestResultText"
                                                           Text=""
                                                           Style="{StaticResource CaptionText}"
                                                           VerticalAlignment="Center"
                                                           TextWrapping="Wrap"
                                                           MaxWidth="480"
                                                           Margin="12,0,0,0" />
                                            </StackPanel>

                                            <TextBlock x:Name="AsrValidationText"
                                                       AutomationProperties.AutomationId="AsrValidationText"
                                                       Visibility="Collapsed"
                                                       Style="{StaticResource CaptionText}"
                                                       Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,10,0,0" />

                                            <!-- 高级调优折叠卡：超时与并发 -->
                                            <ui:CardExpander x:Name="AsrAdvancedExpander"
                                                             AutomationProperties.AutomationId="AsrAdvancedExpander"
                                                             IsExpanded="False"
                                                             Margin="0,16,0,0"
                                                             ContentPadding="16,14"
                                                             Icon="{ui:SymbolIcon Options24}">
                                                <ui:CardExpander.Header>
                                                    <StackPanel>
                                                        <TextBlock Text="高级调优"
                                                                   FontSize="13"
                                                                   FontWeight="Medium"
                                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                        <TextBlock Text="请求超时与识别并发数（默认参数已适配绝大多数网络环境）"
                                                                   Style="{StaticResource CaptionText}"
                                                                   Margin="0,2,0,0" />
                                                    </StackPanel>
                                                </ui:CardExpander.Header>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="24" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="请求超时 (ms)" Style="{StaticResource FieldLabelText}" />
                                                        <ui:NumberBox x:Name="TimeoutBox"
                                                                      Value="30000"
                                                                      Minimum="5000"
                                                                      Maximum="120000"
                                                                      SmallChange="1000"
                                                                      LargeChange="5000"
                                                                      Width="180"
                                                                      ValueChanged="OnNumberSettingChanged"
                                                                      HorizontalAlignment="Left" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="最大并发" Style="{StaticResource FieldLabelText}" />
                                                        <ui:NumberBox x:Name="MaxConcurrencyBox"
                                                                      Value="2"
                                                                      Minimum="1"
                                                                      Maximum="4"
                                                                      SmallChange="1"
                                                                      LargeChange="1"
                                                                      Width="180"
                                                                      ValueChanged="OnNumberSettingChanged"
                                                                      HorizontalAlignment="Left" />
                                                    </StackPanel>
                                                </Grid>
                                            </ui:CardExpander>
                                        </StackPanel>
                                    </Border>

                                    <!-- 字幕翻译 -->
                                    <Border x:Name="TranslationSettingsPanel"
                                            Style="{StaticResource PanelBorder}">
                                        <StackPanel>
                                            <TextBlock Text="字幕翻译"
                                                       AutomationProperties.AutomationId="SettingsTranslationGroup"
                                                       Style="{StaticResource SectionTitleText}" />

                                            <Grid Margin="0,0,0,16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="24" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="目标语言" Style="{StaticResource FieldLabelText}" />
                                                    <ComboBox x:Name="TranslationTargetLanguageBox"
                                                              AutomationProperties.AutomationId="TranslationTargetLanguageBox"
                                                              Width="280"
                                                              HorizontalAlignment="Left"
                                                              VerticalContentAlignment="Center"
                                                              SelectionChanged="OnTranslationSettingChanged">
                                                        <ComboBoxItem Content="中文" Tag="zh-Hans" />
                                                        <ComboBoxItem Content="英语" Tag="en" />
                                                        <ComboBoxItem Content="德语" Tag="de" />
                                                        <ComboBoxItem Content="法语" Tag="fr" />
                                                        <ComboBoxItem Content="日语" Tag="ja" />
                                                    </ComboBox>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="翻译" Style="{StaticResource FieldLabelText}" />
                                                    <ui:ToggleSwitch x:Name="TranslationEnabledSwitch"
                                                                     AutomationProperties.AutomationId="TranslationEnabledSwitch"
                                                                     Content="启用翻译"
                                                                     IsChecked="False"
                                                                     Checked="OnTranslationSettingChanged"
                                                                     Unchecked="OnTranslationSettingChanged" />
                                                </StackPanel>
                                            </Grid>

                                            <TextBlock Text="模型配置"
                                                       FontSize="13"
                                                       FontWeight="Medium"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                            <TextBlock x:Name="TranslationSelectionSummaryText"
                                                       AutomationProperties.AutomationId="TranslationSelectionSummaryText"
                                                       Text="尚未添加配置"
                                                       Style="{StaticResource CaptionText}"
                                                       MaxWidth="420"
                                                       HorizontalAlignment="Left"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"
                                                       Margin="0,4,0,8" />

                                            <ListBox x:Name="TranslationProfileList"
                                                     AutomationProperties.AutomationId="TranslationProfileList"
                                                     MinHeight="56"
                                                     MaxHeight="210"
                                                     Margin="0,0,0,12"
                                                     BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                     BorderThickness="1"
                                                     Background="Transparent"
                                                     HorizontalContentAlignment="Stretch"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                     SelectionChanged="OnTranslationProfileSelectionChanged">
                                                <ListBox.ItemContainerStyle>
                                                    <Style TargetType="ListBoxItem">
                                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                        <Setter Property="Padding" Value="12,9" />
                                                    </Style>
                                                </ListBox.ItemContainerStyle>
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="28" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <ui:SymbolIcon Symbol="Translate24"
                                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                           VerticalAlignment="Center" />
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Medium" />
                                                                <TextBlock Text="{Binding Endpoint}"
                                                                           FontSize="11"
                                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           ToolTip="{Binding Endpoint}" />
                                                            </StackPanel>
                                                            <Border Grid.Column="2"
                                                                    CornerRadius="10"
                                                                    Padding="8,2"
                                                                    Margin="10,0,6,0"
                                                                    VerticalAlignment="Center">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsValidated}" Value="True">
                                                                                <Setter Property="Background" Value="{DynamicResource AcousticLiveSoftBrush}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock Text="{Binding ValidationStatus}"
                                                                           FontSize="11.5"
                                                                           FontWeight="Medium">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsValidated}" Value="True">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource AcousticLiveBrush}" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Border>
                                                            <!-- 行内快捷操作：无需先选中再到底部找按钮 -->
                                                            <StackPanel Grid.Column="3"
                                                                        Orientation="Horizontal"
                                                                        VerticalAlignment="Center">
                                                                <ui:Button Tag="{Binding Id}"
                                                                           Click="OnInlineTestTranslationProfileClick"
                                                                           ToolTip="测试此模型连接"
                                                                           Appearance="Transparent"
                                                                           BorderThickness="0"
                                                                           Width="30"
                                                                           Height="30"
                                                                           Padding="0"
                                                                           Margin="0,0,2,0">
                                                                    <ui:SymbolIcon Symbol="PlugConnected20" FontSize="14" />
                                                                </ui:Button>
                                                                <ui:Button Tag="{Binding Id}"
                                                                           Click="OnInlineEditTranslationProfileClick"
                                                                           ToolTip="编辑此模型配置"
                                                                           Appearance="Transparent"
                                                                           BorderThickness="0"
                                                                           Width="30"
                                                                           Height="30"
                                                                           Padding="0"
                                                                           Margin="0,0,2,0">
                                                                    <ui:SymbolIcon Symbol="Edit20" FontSize="14" />
                                                                </ui:Button>
                                                                <ui:Button Tag="{Binding Id}"
                                                                           Click="OnInlineDeleteTranslationProfileClick"
                                                                           ToolTip="删除此模型配置"
                                                                           Appearance="Transparent"
                                                                           BorderThickness="0"
                                                                           Width="30"
                                                                           Height="30"
                                                                           Padding="0">
                                                                    <ui:SymbolIcon Symbol="Delete20" FontSize="14" />
                                                                </ui:Button>
                                                            </StackPanel>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>

                                            <DockPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:Button Click="OnAddTranslationProfileClick"
                                                               AutomationProperties.AutomationId="AddTranslationProfileButton"
                                                               Icon="{ui:SymbolIcon Add24}"
                                                               Content="添加模型"
                                                               Margin="0,0,8,0" />
                                                    <ui:Button x:Name="EditTranslationProfileButton"
                                                               AutomationProperties.AutomationId="EditTranslationProfileButton"
                                                               Click="OnEditTranslationProfileClick"
                                                               ToolTip="编辑选中配置"
                                                               Width="34" Height="34" Padding="0" Margin="0,0,6,0">
                                                        <ui:SymbolIcon Symbol="Edit20" FontSize="14" />
                                                    </ui:Button>
                                                    <ui:Button x:Name="CopyTranslationProfileButton"
                                                               AutomationProperties.AutomationId="CopyTranslationProfileButton"
                                                               Click="OnCopyTranslationProfileClick"
                                                               ToolTip="复制选中配置"
                                                               Width="34" Height="34" Padding="0" Margin="0,0,6,0">
                                                        <ui:SymbolIcon Symbol="Copy20" FontSize="14" />
                                                    </ui:Button>
                                                    <ui:Button x:Name="DeleteTranslationProfileButton"
                                                               AutomationProperties.AutomationId="DeleteTranslationProfileButton"
                                                               Click="OnDeleteTranslationProfileClick"
                                                               ToolTip="删除选中配置"
                                                               Width="34" Height="34" Padding="0">
                                                        <ui:SymbolIcon Symbol="Delete20" FontSize="14" />
                                                    </ui:Button>
                                                    <ui:Button x:Name="TestTranslationProfileButton"
                                                               AutomationProperties.AutomationId="TestTranslationProfileButton"
                                                               Click="OnTestTranslationProfileClick"
                                                               Icon="{ui:SymbolIcon PlugConnected24}"
                                                               Margin="12,0,0,0"
                                                               Content="测试连接" />
                                                    <ui:ProgressRing x:Name="TranslationTestProgressRing"
                                                                     IsIndeterminate="True"
                                                                     Width="16"
                                                                     Height="16"
                                                                     Margin="12,0,0,0"
                                                                     VerticalAlignment="Center"
                                                                     Visibility="Collapsed" />
                                                </StackPanel>
                                            </DockPanel>
                                            <TextBlock x:Name="TranslationRemoteNoticeText"
                                                       Text="当前字幕及近期上下文将发送到此 API 地址。"
                                                       Visibility="Collapsed"
                                                       Style="{StaticResource CaptionText}"
                                                       Margin="0,10,0,0"
                                                       TextWrapping="Wrap" />
                                            <TextBlock x:Name="TranslationTestResultText"
                                                       Text=""
                                                       Style="{StaticResource CaptionText}"
                                                       Margin="0,8,0,0"
                                                       TextWrapping="Wrap" />

                                            <!-- 高级调优折叠卡：翻译积累上限 -->
                                            <ui:CardExpander x:Name="TranslationAdvancedExpander"
                                                             AutomationProperties.AutomationId="TranslationAdvancedExpander"
                                                             IsExpanded="False"
                                                             Margin="0,16,0,0"
                                                             ContentPadding="16,14"
                                                             Icon="{ui:SymbolIcon Options24}">
                                                <ui:CardExpander.Header>
                                                    <StackPanel>
                                                        <TextBlock Text="高级调优"
                                                                   FontSize="13"
                                                                   FontWeight="Medium"
                                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                        <TextBlock Text="长句翻译积累上限（字符）与连贯性权衡"
                                                                   Style="{StaticResource CaptionText}"
                                                                   Margin="0,2,0,0" />
                                                    </StackPanel>
                                                </ui:CardExpander.Header>
                                                <StackPanel>
                                                    <TextBlock Text="翻译积累上限（字符）"
                                                               Style="{StaticResource FieldLabelText}" />
                                                    <ui:NumberBox x:Name="SentenceAccumulationLimitBox"
                                                                  AutomationProperties.AutomationId="SentenceAccumulationLimitBox"
                                                                  Value="350"
                                                                  Minimum="50"
                                                                  Maximum="800"
                                                                  SmallChange="50"
                                                                  LargeChange="100"
                                                                  Width="180"
                                                                  HorizontalAlignment="Left"
                                                                  ValueChanged="OnNumberSettingChanged" />
                                                    <TextBlock Style="{StaticResource CaptionText}"
                                                               TextWrapping="Wrap"
                                                               Margin="0,8,0,0">
                                                        <Run>积累更多内容再翻译可提升连贯性，但会增加翻译延迟。</Run>
                                                        <LineBreak />
                                                        <Run>建议与“最长片段”配套设置：积累上限（字符）≥ 最长片段（ms）× 0.028。</Run>
                                                        <LineBreak />
                                                        <Run>示例：最长片段 9000 ms → 建议 ≥ 250；12000 ms → 建议 ≥ 350。</Run>
                                                    </TextBlock>
                                                </StackPanel>
                                            </ui:CardExpander>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- =========================================================
                                     Tab 2：音频与断句
                                     ========================================================= -->
                                <StackPanel x:Name="SettingsAudioPanel" Visibility="Collapsed">
                                    <Border Style="{StaticResource PanelBorder}">
                                        <StackPanel>
                                            <TextBlock Text="音频与断句"
                                                       AutomationProperties.AutomationId="SettingsAudioGroup"
                                                       Style="{StaticResource SectionTitleText}" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="24" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,18">
                                                    <DockPanel Margin="0,0,0,6">
                                                        <TextBlock Text="输出设备" Style="{StaticResource FieldLabelText}" Margin="0" VerticalAlignment="Center" />
                                                        <ui:Button DockPanel.Dock="Right"
                                                                   AutomationProperties.AutomationId="RefreshAudioDevicesButton"
                                                                   ToolTip="刷新设备列表"
                                                                   Padding="4,2"
                                                                   HorizontalAlignment="Right"
                                                                   Appearance="Transparent"
                                                                   BorderThickness="0"
                                                                   Click="OnRefreshAudioDevicesClick">
                                                            <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="14" />
                                                        </ui:Button>
                                                    </DockPanel>
                                                    <ComboBox x:Name="AudioDeviceComboBox"
                                                              AutomationProperties.AutomationId="AudioDeviceComboBox"
                                                              VerticalContentAlignment="Center"
                                                              SelectionChanged="OnAudioDeviceSelectionChanged" />
                                                </StackPanel>
                                                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,18">
                                                    <TextBlock Text="默认设备" Style="{StaticResource FieldLabelText}" />
                                                    <ui:ToggleSwitch x:Name="FollowDefaultDeviceSwitch"
                                                                     AutomationProperties.AutomationId="FollowDefaultDeviceSwitch"
                                                                     Content="跟随系统默认设备"
                                                                     IsChecked="True"
                                                                     Checked="OnAnySettingChanged"
                                                                     Unchecked="OnAnySettingChanged" />
                                                </StackPanel>

                                                <StackPanel Grid.Row="1"
                                                            Grid.Column="0"
                                                            Grid.ColumnSpan="3"
                                                            Margin="0,0,0,16">
                                                    <Grid Margin="0,0,0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="24" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0"
                                                                   Text="断句策略"
                                                                   Style="{StaticResource FieldLabelText}"
                                                                   Margin="0" />
                                                        <TextBlock x:Name="CurrentVadEndpointText"
                                                                   AutomationProperties.AutomationId="CurrentVadEndpointText"
                                                                   Grid.Column="2"
                                                                   Text="当前断句等待：400ms（均衡，自适应）"
                                                                   Style="{StaticResource CaptionText}"
                                                                   Typography.NumeralAlignment="Tabular"
                                                                   HorizontalAlignment="Left" />
                                                    </Grid>

                                                    <!-- 自适应宽度的 4 档断句策略分段器（移除 456px 硬编码） -->
                                                    <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="6"
                                                            HorizontalAlignment="Stretch"
                                                            MaxWidth="520">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <RadioButton x:Name="LowLatencyVadModeButton"
                                                                         Grid.Column="0"
                                                                         GroupName="VadEndpointMode"
                                                                         Content="低延迟"
                                                                         Tag="LowLatency"
                                                                         AutomationProperties.AutomationId="VadModeLowLatency"
                                                                         Checked="OnVadEndpointModeChecked"
                                                                         Style="{StaticResource SegmentedOptionStyle}" />
                                                            <RadioButton x:Name="BalancedVadModeButton"
                                                                         Grid.Column="1"
                                                                         GroupName="VadEndpointMode"
                                                                         Content="均衡"
                                                                         Tag="Balanced"
                                                                         IsChecked="True"
                                                                         AutomationProperties.AutomationId="VadModeBalanced"
                                                                         Checked="OnVadEndpointModeChecked"
                                                                         Style="{StaticResource SegmentedOptionStyle}" />
                                                            <RadioButton x:Name="SentenceCompleteVadModeButton"
                                                                         Grid.Column="2"
                                                                         GroupName="VadEndpointMode"
                                                                         Content="句子完整"
                                                                         Tag="SentenceComplete"
                                                                         AutomationProperties.AutomationId="VadModeSentenceComplete"
                                                                         Checked="OnVadEndpointModeChecked"
                                                                         Style="{StaticResource SegmentedOptionStyle}" />
                                                            <RadioButton x:Name="FixedVadModeButton"
                                                                         Grid.Column="3"
                                                                         GroupName="VadEndpointMode"
                                                                         Content="固定值"
                                                                         Tag="Fixed"
                                                                         AutomationProperties.AutomationId="VadModeFixed"
                                                                         Checked="OnVadEndpointModeChecked"
                                                                         Style="{StaticResource SegmentedOptionStyle}" />
                                                        </Grid>
                                                    </Border>

                                                    <!-- 动态单条解释卡片 + 200~800ms 延迟区间条 -->
                                                    <Border x:Name="VadModeDetailCard"
                                                            AutomationProperties.AutomationId="VadModeDetailCard"
                                                            Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="8"
                                                            Padding="14,12"
                                                            Margin="0,12,0,0">
                                                        <StackPanel>
                                                            <DockPanel Margin="0,0,0,6">
                                                                <TextBlock x:Name="VadModeDetailTitleText"
                                                                           Text="均衡（推荐）"
                                                                           FontSize="13"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                                <TextBlock x:Name="VadModeDetailRangeText"
                                                                           DockPanel.Dock="Right"
                                                                           Text="自适应区间 280 – 600 ms"
                                                                           FontSize="12"
                                                                           FontWeight="Medium"
                                                                           Typography.NumeralAlignment="Tabular"
                                                                           Foreground="{DynamicResource AcousticLiveBrush}"
                                                                           HorizontalAlignment="Right" />
                                                            </DockPanel>
                                                            <TextBlock x:Name="VadModeDetailDescriptionText"
                                                                       Text="根据说话人的停顿习惯动态微调切段时机，在大多数直播、网课与会议中兼顾响应速度与语义完整。"
                                                                       Style="{StaticResource CaptionText}"
                                                                       TextWrapping="Wrap"
                                                                       Margin="0,0,0,10" />
                                                            <!-- 200ms – 800ms 延迟可视化刻度条 -->
                                                            <Grid Height="6" Margin="0,0,0,4">
                                                                <Border Background="{DynamicResource AcousticMeterTrackBrush}" CornerRadius="3" />
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition x:Name="VadRangeLeftCol" Width="80*" />
                                                                        <ColumnDefinition x:Name="VadRangeActiveCol" Width="320*" />
                                                                        <ColumnDefinition x:Name="VadRangeRightCol" Width="200*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <Border Grid.Column="1"
                                                                            Background="{DynamicResource AcousticLiveBrush}"
                                                                            CornerRadius="3" />
                                                                </Grid>
                                                            </Grid>
                                                            <DockPanel>
                                                                <TextBlock Text="200ms（极速）"
                                                                           FontSize="11"
                                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                                <TextBlock DockPanel.Dock="Right"
                                                                           Text="800ms（完整）"
                                                                           FontSize="11"
                                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                                           HorizontalAlignment="Right" />
                                                            </DockPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>

                                                <StackPanel Grid.Row="2" Grid.Column="0">
                                                    <TextBlock Text="固定断句等待 (ms)" Style="{StaticResource FieldLabelText}" />
                                                    <ui:NumberBox x:Name="EndSilenceBox"
                                                                  AutomationProperties.AutomationId="FixedEndSilenceBox"
                                                                  Value="400"
                                                                  Minimum="200"
                                                                  Maximum="800"
                                                                  SmallChange="50"
                                                                  LargeChange="100"
                                                                  Width="180"
                                                                  IsEnabled="False"
                                                                  ValueChanged="OnFixedEndSilenceValueChanged"
                                                                  HorizontalAlignment="Left" />
                                                    <TextBlock Text="仅在选择“固定值”策略时可调整。"
                                                               Style="{StaticResource CaptionText}"
                                                               Margin="0,4,0,0" />
                                                </StackPanel>
                                            </Grid>

                                            <!-- 进阶断句参数折叠卡 -->
                                            <ui:CardExpander x:Name="AudioAdvancedExpander"
                                                             AutomationProperties.AutomationId="AudioAdvancedExpander"
                                                             IsExpanded="False"
                                                             Margin="0,18,0,0"
                                                             ContentPadding="16,14"
                                                             Icon="{ui:SymbolIcon Options24}">
                                                <ui:CardExpander.Header>
                                                    <StackPanel>
                                                        <TextBlock Text="进阶断句参数"
                                                                   FontSize="13"
                                                                   FontWeight="Medium"
                                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                        <TextBlock Text="最短/最长语音片段上限与自适应 VAD 统计样本状态"
                                                                   Style="{StaticResource CaptionText}"
                                                                   Margin="0,2,0,0" />
                                                    </StackPanel>
                                                </ui:CardExpander.Header>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="24" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,14">
                                                        <TextBlock Text="最短片段 (ms)" Style="{StaticResource FieldLabelText}" />
                                                        <ui:NumberBox x:Name="MinSegmentBox"
                                                                      Value="900"
                                                                      Minimum="300"
                                                                      Maximum="3000"
                                                                      SmallChange="100"
                                                                      LargeChange="300"
                                                                      Width="180"
                                                                      ValueChanged="OnNumberSettingChanged"
                                                                      HorizontalAlignment="Left" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,14">
                                                        <TextBlock Text="最长片段 (ms)" Style="{StaticResource FieldLabelText}" />
                                                        <ui:NumberBox x:Name="HardMaxSegmentBox"
                                                                      AutomationProperties.AutomationId="HardMaxSegmentBox"
                                                                      Value="10000"
                                                                      Minimum="6000"
                                                                      Maximum="20000"
                                                                      SmallChange="1000"
                                                                      LargeChange="2000"
                                                                      Width="180"
                                                                      ValueChanged="OnNumberSettingChanged"
                                                                      HorizontalAlignment="Left" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3">
                                                        <TextBlock Text="自适应状态" Style="{StaticResource FieldLabelText}" />
                                                        <TextBlock x:Name="AdaptiveVadStatusText"
                                                                   AutomationProperties.AutomationId="AdaptiveVadStatusText"
                                                                   Text="等待运行"
                                                                   Style="{StaticResource CaptionText}"
                                                                   Typography.NumeralAlignment="Tabular"
                                                                   TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Grid>
                                            </ui:CardExpander>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- =========================================================
                                     Tab 3：悬浮窗外观（顶部内嵌所见即所得实时预览舞台）
                                     ========================================================= -->
                                <StackPanel x:Name="SettingsFloatingPanel" Visibility="Collapsed">
                                    <Border Style="{StaticResource PanelBorder}">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,12">
                                                <TextBlock Text="悬浮字幕窗"
                                                           AutomationProperties.AutomationId="SettingsFloatingGroup"
                                                           Style="{StaticResource SectionTitleText}"
                                                           Margin="0"
                                                           VerticalAlignment="Center" />
                                                <Border DockPanel.Dock="Right"
                                                        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        HorizontalAlignment="Right">
                                                    <StackPanel Orientation="Horizontal">
                                                        <RadioButton x:Name="PreviewBgDarkVideoButton"
                                                                     GroupName="FloatingPreviewBackdrop"
                                                                     Content="暗色视频底"
                                                                     Tag="DarkVideo"
                                                                     IsChecked="True"
                                                                     Checked="OnPreviewBackdropChecked"
                                                                     Style="{StaticResource CompactSegmentedOptionStyle}" />
                                                        <RadioButton x:Name="PreviewBgLightPptButton"
                                                                     GroupName="FloatingPreviewBackdrop"
                                                                     Content="亮色 PPT 底"
                                                                     Tag="LightPpt"
                                                                     Checked="OnPreviewBackdropChecked"
                                                                     Style="{StaticResource CompactSegmentedOptionStyle}" />
                                                        <RadioButton x:Name="PreviewBgWallpaperButton"
                                                                     GroupName="FloatingPreviewBackdrop"
                                                                     Content="桌面壁纸底"
                                                                     Tag="Wallpaper"
                                                                     Checked="OnPreviewBackdropChecked"
                                                                     Style="{StaticResource CompactSegmentedOptionStyle}" />
                                                    </StackPanel>
                                                </Border>
                                            </DockPanel>

                                            <!-- 所见即所得迷你预览舞台 -->
                                            <Border x:Name="FloatingPreviewStage"
                                                    AutomationProperties.AutomationId="FloatingPreviewStage"
                                                    Height="192"
                                                    CornerRadius="10"
                                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    ClipToBounds="True"
                                                    Margin="0,0,0,18">
                                                <Grid>
                                                    <!-- 场景 1：暗色视频底 -->
                                                    <Grid x:Name="PreviewBackdropDarkVideo">
                                                        <Border>
                                                            <Border.Background>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                    <GradientStop Color="#0D1624" Offset="0" />
                                                                    <GradientStop Color="#1B2C42" Offset="0.55" />
                                                                    <GradientStop Color="#0F1826" Offset="1" />
                                                                </LinearGradientBrush>
                                                            </Border.Background>
                                                        </Border>
                                                        <Ellipse Width="260" Height="160"
                                                                 HorizontalAlignment="Left" VerticalAlignment="Top"
                                                                 Margin="-40,-50,0,0"
                                                                 Fill="#1E38BDF8" />
                                                        <Ellipse Width="220" Height="140"
                                                                 HorizontalAlignment="Right" VerticalAlignment="Top"
                                                                 Margin="0,-30,-30,0"
                                                                 Fill="#1A2DD4A3" />
                                                        <TextBlock Text="LIVE · 1080p 视频画面预览"
                                                                   FontSize="10.5"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#66FFFFFF"
                                                                   HorizontalAlignment="Left"
                                                                   VerticalAlignment="Top"
                                                                   Margin="14,10,0,0" />
                                                    </Grid>

                                                    <!-- 场景 2：亮色 PPT / 文档底 -->
                                                    <Grid x:Name="PreviewBackdropLightPpt" Visibility="Collapsed">
                                                        <Border Background="#F4F6FA" />
                                                        <StackPanel Margin="24,18,24,0" VerticalAlignment="Top">
                                                            <Border Width="210" Height="14" CornerRadius="3" Background="#D5DCE7" HorizontalAlignment="Left" Margin="0,0,0,12" />
                                                            <Border Width="380" Height="8" CornerRadius="2" Background="#E2E7F0" HorizontalAlignment="Left" Margin="0,0,0,8" />
                                                            <Border Width="320" Height="8" CornerRadius="2" Background="#E2E7F0" HorizontalAlignment="Left" Margin="0,0,0,8" />
                                                            <Border Width="260" Height="8" CornerRadius="2" Background="#E9EDF4" HorizontalAlignment="Left" />
                                                        </StackPanel>
                                                        <TextBlock Text="SLIDE · 亮色 PPT / 会议白底预览"
                                                                   FontSize="10.5"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#88526074"
                                                                   HorizontalAlignment="Right"
                                                                   VerticalAlignment="Top"
                                                                   Margin="0,10,14,0" />
                                                    </Grid>

                                                    <!-- 场景 3：桌面壁纸底 -->
                                                    <Grid x:Name="PreviewBackdropWallpaper" Visibility="Collapsed">
                                                        <Border>
                                                            <Border.Background>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                    <GradientStop Color="#1E3A8A" Offset="0" />
                                                                    <GradientStop Color="#0D9488" Offset="0.52" />
                                                                    <GradientStop Color="#D97706" Offset="1" />
                                                                </LinearGradientBrush>
                                                            </Border.Background>
                                                        </Border>
                                                        <Ellipse Width="280" Height="220"
                                                                 HorizontalAlignment="Center" VerticalAlignment="Top"
                                                                 Margin="0,-70,0,0"
                                                                 Fill="#2EFFFFFF" />
                                                        <TextBlock Text="DESKTOP · 彩色壁纸对比度预览"
                                                                   FontSize="10.5"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#88FFFFFF"
                                                                   HorizontalAlignment="Left"
                                                                   VerticalAlignment="Top"
                                                                   Margin="14,10,0,0" />
                                                    </Grid>

                                                    <!-- 实时同步外观的迷你悬浮窗本体 -->
                                                    <Grid HorizontalAlignment="Center"
                                                          VerticalAlignment="Bottom"
                                                          Margin="24,18,24,14"
                                                          MaxWidth="560"
                                                          MinWidth="380">
                                                        <Border x:Name="PreviewChromeBackdrop"
                                                                CornerRadius="10"
                                                                BorderThickness="1">
                                                            <Border.Background>
                                                                <SolidColorBrush x:Name="PreviewChromeBackgroundBrush" Color="#0F141B" Opacity="0.72" />
                                                            </Border.Background>
                                                            <Border.BorderBrush>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                    <GradientStop x:Name="PreviewChromeBorderTopStop" Color="#3DFFFFFF" Offset="0" />
                                                                    <GradientStop x:Name="PreviewChromeBorderBottomStop" Color="#14FFFFFF" Offset="1" />
                                                                </LinearGradientBrush>
                                                            </Border.BorderBrush>
                                                            <Border.Effect>
                                                                <DropShadowEffect x:Name="PreviewChromeShadowEffect"
                                                                                  Color="#000000"
                                                                                  BlurRadius="16"
                                                                                  ShadowDepth="3"
                                                                                  Direction="270"
                                                                                  Opacity="0.46" />
                                                            </Border.Effect>
                                                        </Border>

                                                        <Border CornerRadius="10" Padding="18,10,18,12" Background="Transparent">
                                                            <StackPanel>
                                                                <!-- 第 3 条（最旧，仅显示字幕数=3 时可见） -->
                                                                <StackPanel x:Name="PreviewEntryOldest" Opacity="0.44" Margin="0,0,0,5" Visibility="Collapsed">
                                                                    <TextBlock x:Name="PreviewOldestPrimaryText"
                                                                               Text="Let's review the acoustic pipeline first."
                                                                               TextAlignment="Center"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock x:Name="PreviewOldestSecondaryText"
                                                                               Text="我们先快速回顾一下声学识别链路。"
                                                                               TextAlignment="Center"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               Margin="0,1,0,0" />
                                                                </StackPanel>

                                                                <!-- 第 2 条（上一句，显示字幕数>=2 时可见） -->
                                                                <StackPanel x:Name="PreviewEntryPrevious" Opacity="0.62" Margin="0,0,0,5">
                                                                    <TextBlock x:Name="PreviewPrevPrimaryText"
                                                                               Text="Adaptive VAD trims pauses automatically."
                                                                               TextAlignment="Center"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock x:Name="PreviewPrevSecondaryText"
                                                                               Text="自适应断句会根据语速动态调整停顿窗口。"
                                                                               TextAlignment="Center"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               Margin="0,1,0,0" />
                                                                </StackPanel>

                                                                <!-- 第 1 条（最新焦点字幕） -->
                                                                <StackPanel x:Name="PreviewEntryLatest" Opacity="1">
                                                                    <TextBlock x:Name="PreviewLatestPrimaryText"
                                                                               Text="Real-time bilingual captions stay clear on any screen."
                                                                               TextAlignment="Center"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock x:Name="PreviewLatestSecondaryText"
                                                                               Text="双语实时字幕在明暗画面下都能清晰易读。"
                                                                               TextAlignment="Center"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               Margin="0,2,0,0" />
                                                                </StackPanel>

                                                                <!-- 底部 2.5px 微光条示意 -->
                                                                <Border Width="64"
                                                                        Height="2.5"
                                                                        CornerRadius="1.25"
                                                                        Background="#FF2DD4A3"
                                                                        HorizontalAlignment="Center"
                                                                        Margin="0,7,0,-4" />
                                                            </StackPanel>
                                                        </Border>
                                                    </Grid>
                                                </Grid>
                                            </Border>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="24" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,16">
                                                    <TextBlock Text="显示模式" Style="{StaticResource FieldLabelText}" />
                                                    <ComboBox x:Name="FloatingDisplayModeBox"
                                                              AutomationProperties.AutomationId="FloatingDisplayModeBox"
                                                              Width="250"
                                                              HorizontalAlignment="Left"
                                                              VerticalContentAlignment="Center"
                                                              SelectionChanged="OnFloatingAppearanceSelectionChanged">
                                                        <ComboBoxItem Content="双语 · 原文优先" Tag="BilingualSourceFirst" />
                                                        <ComboBoxItem Content="双语 · 译文优先（推荐看外语）" Tag="BilingualTranslationFirst" />
                                                        <ComboBoxItem Content="仅显示译文" Tag="TranslationOnly" />
                                                        <ComboBoxItem Content="仅显示原文" Tag="SourceOnly" />
                                                    </ComboBox>
                                                </StackPanel>
                                                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,16">
                                                    <TextBlock Text="可读性皮肤预设" Style="{StaticResource FieldLabelText}" />
                                                    <ComboBox x:Name="FloatingThemeBox"
                                                              AutomationProperties.AutomationId="FloatingThemeBox"
                                                              Width="250"
                                                              HorizontalAlignment="Left"
                                                              VerticalContentAlignment="Center"
                                                              SelectionChanged="OnFloatingAppearanceSelectionChanged">
                                                        <ComboBoxItem Content="影院暗玻璃（默认）" Tag="CinemaGlass" />
                                                        <ComboBoxItem Content="亮底高对比（适配 PPT / 白底）" Tag="HighContrast" />
                                                        <ComboBoxItem Content="极简浮字（适配全屏视频 / 游戏）" Tag="MinimalFloating" />
                                                    </ComboBox>
                                                </StackPanel>

                                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,16">
                                                    <TextBlock Text="字号" Style="{StaticResource FieldLabelText}" />
                                                    <ui:NumberBox x:Name="FloatingFontSizeBox"
                                                                  Value="18"
                                                                  Minimum="12"
                                                                  Maximum="72"
                                                                  SmallChange="1"
                                                                  LargeChange="4"
                                                                  Width="180"
                                                                  ValueChanged="OnFloatingNumberSettingChanged"
                                                                  HorizontalAlignment="Left" />
                                                </StackPanel>
                                                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,16">
                                                    <TextBlock Text="显示字幕数" Style="{StaticResource FieldLabelText}" />
                                                    <ui:NumberBox x:Name="FloatingLinesBox"
                                                                  Value="2"
                                                                  Minimum="1"
                                                                  Maximum="3"
                                                                  SmallChange="1"
                                                                  LargeChange="1"
                                                                  Width="180"
                                                                  ValueChanged="OnFloatingNumberSettingChanged"
                                                                  HorizontalAlignment="Left" />
                                                </StackPanel>

                                                <StackPanel Grid.Row="2" Grid.Column="0">
                                                    <DockPanel Width="260" HorizontalAlignment="Left" Margin="0,0,0,6">
                                                        <TextBlock Text="底板不透明度" Style="{StaticResource FieldLabelText}" Margin="0" />
                                                        <TextBlock x:Name="FloatingOpacityValueText"
                                                                   DockPanel.Dock="Right"
                                                                   Text="72%"
                                                                   Typography.NumeralAlignment="Tabular"
                                                                   Style="{StaticResource CaptionText}"
                                                                   HorizontalAlignment="Right" />
                                                    </DockPanel>
                                                    <Slider x:Name="FloatingOpacitySlider"
                                                            Minimum="0"
                                                            Maximum="0.95"
                                                            Value="0.72"
                                                            Width="260"
                                                            ValueChanged="OnFloatingOpacityChanged"
                                                            HorizontalAlignment="Left" />
                                                </StackPanel>
                                                <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                                                    <ui:Button Click="OnShowFloatingWindowClick"
                                                               Icon="{ui:SymbolIcon Window24}"
                                                               Content="显示/隐藏"
                                                               Margin="0,0,8,0" />
                                                    <ui:Button x:Name="FloatingLockButton"
                                                               AutomationProperties.AutomationId="FloatingLockButton"
                                                               Click="OnToggleFloatingLockClick"
                                                               Icon="{ui:SymbolIcon LockClosed24}"
                                                               Content="锁定悬浮窗" />
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Text="提示：未锁定时鼠标悬停在悬浮窗上可弹出快捷微控栏，拖动左右边缘可调整宽度，右键可快速切换显示模式与皮肤。"
                                                       Style="{StaticResource CaptionText}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,12,0,0" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- =========================================================
                                     Tab 4：通用（外观 + 系统托盘 + 键帽快捷键 + 诊断）
                                     ========================================================= -->
                                <StackPanel x:Name="SettingsGeneralPanel" Visibility="Collapsed">
                                    <!-- 外观与系统托盘 -->
                                    <Border Style="{StaticResource PanelBorder}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="24" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="外观"
                                                           AutomationProperties.AutomationId="SettingsAppearanceGroup"
                                                           Style="{StaticResource SectionTitleText}" />
                                                <TextBlock Text="主题" Style="{StaticResource FieldLabelText}" />
                                                <ComboBox x:Name="ThemeModeComboBox"
                                                          AutomationProperties.AutomationId="ThemeModeComboBox"
                                                          Width="220"
                                                          HorizontalAlignment="Left"
                                                          VerticalContentAlignment="Center"
                                                          SelectionChanged="OnThemeModeChanged">
                                                    <ComboBoxItem Content="跟随系统" Tag="System" />
                                                    <ComboBoxItem Content="亮色" Tag="Light" />
                                                    <ComboBoxItem Content="暗色" Tag="Dark" />
                                                </ComboBox>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="系统托盘"
                                                           AutomationProperties.AutomationId="SettingsTrayGroup"
                                                           Style="{StaticResource SectionTitleText}" />
                                                <ui:ToggleSwitch x:Name="CloseToTraySwitch"
                                                                 AutomationProperties.AutomationId="CloseToTraySwitch"
                                                                 Content="关闭主窗口时收入系统托盘"
                                                                 IsChecked="False"
                                                                 Margin="0,0,0,10"
                                                                 Checked="OnAnySettingChanged"
                                                                 Unchecked="OnAnySettingChanged" />
                                                <ui:ToggleSwitch x:Name="MinimizeToTraySwitch"
                                                                 AutomationProperties.AutomationId="MinimizeToTraySwitch"
                                                                 Content="最小化时隐藏到系统托盘"
                                                                 IsChecked="False"
                                                                 Checked="OnAnySettingChanged"
                                                                 Unchecked="OnAnySettingChanged" />
                                                <TextBlock Text="托盘图标带实时状态角标；左键单击可快速呼出或隐藏主窗，右键支持启停、悬浮窗控制与彻底退出。"
                                                           Style="{StaticResource CaptionText}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,8,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- 全局快捷键（键帽样式）与诊断模式 -->
                                    <Border Style="{StaticResource PanelBorder}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.2*" />
                                                <ColumnDefinition Width="24" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="快捷键"
                                                           AutomationProperties.AutomationId="SettingsDiagnosticsGroup"
                                                           Style="{StaticResource SectionTitleText}" />
                                                <ui:ToggleSwitch x:Name="HotkeysEnabledSwitch"
                                                                 Content="启用全局快捷键"
                                                                 IsChecked="True"
                                                                 Margin="0,0,0,12"
                                                                 Checked="OnHotkeysEnabledChanged"
                                                                 Unchecked="OnHotkeysEnabledChanged" />

                                                <StackPanel>
                                                    <DockPanel Margin="0,0,0,8">
                                                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Border Style="{StaticResource KeycapBorderStyle}"><TextBlock Text="Ctrl" Style="{StaticResource KeycapTextStyle}" /></Border>
                                                            <TextBlock Text="+" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="5,0" />
                                                            <Border Style="{StaticResource KeycapBorderStyle}"><TextBlock Text="Alt" Style="{StaticResource KeycapTextStyle}" /></Border>
                                                            <TextBlock Text="+" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="5,0" />
                                                            <Border Style="{StaticResource KeycapBorderStyle}"><TextBlock Text="S" Style="{StaticResource KeycapTextStyle}" /></Border>
                                                        </StackPanel>
                                                        <TextBlock Text="开始 / 停止字幕"
                                                                   Style="{StaticResource CaptionText}"
                                                                   VerticalAlignment="Center"
                                                                   Margin="14,0,0,0" />
                                                    </DockPanel>
                                                    <DockPanel Margin="0,0,0,8">
                                                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Border Style="{StaticResource KeycapBorderStyle}"><TextBlock Text="Ctrl" Style="{StaticResource KeycapTextStyle}" /></Border>
                                                            <TextBlock Text="+" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="5,0" />
                                                            <Border Style="{StaticResource KeycapBorderStyle}"><TextBlock Text="Alt" Style="{StaticResource KeycapTextStyle}" /></Border>
                                                            <TextBlock Text="+" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="5,0" />
                                                            <Border Style="{StaticResource KeycapBorderStyle}"><TextBlock Text="H" Style="{StaticResource KeycapTextStyle}" /></Border>
                                                        </StackPanel>
                                                        <TextBlock Text="显示 / 隐藏悬浮窗"
                                                                   Style="{StaticResource CaptionText}"
                                                                   VerticalAlignment="Center"
                                                                   Margin="14,0,0,0" />
                                                    </DockPanel>
                                                    <DockPanel>
                                                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Border Style="{StaticResource KeycapBorderStyle}"><TextBlock Text="Ctrl" Style="{StaticResource KeycapTextStyle}" /></Border>
                                                            <TextBlock Text="+" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="5,0" />
                                                            <Border Style="{StaticResource KeycapBorderStyle}"><TextBlock Text="Alt" Style="{StaticResource KeycapTextStyle}" /></Border>
                                                            <TextBlock Text="+" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="5,0" />
                                                            <Border Style="{StaticResource KeycapBorderStyle}"><TextBlock Text="L" Style="{StaticResource KeycapTextStyle}" /></Border>
                                                        </StackPanel>
                                                        <TextBlock Text="锁定 / 解锁悬浮窗"
                                                                   Style="{StaticResource CaptionText}"
                                                                   VerticalAlignment="Center"
                                                                   Margin="14,0,0,0" />
                                                    </DockPanel>
                                                </StackPanel>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="诊断" Style="{StaticResource SectionTitleText}" />
                                                <ui:ToggleSwitch x:Name="DiagnosticsSwitch"
                                                                 Content="诊断模式"
                                                                 Checked="OnAnySettingChanged"
                                                                 Unchecked="OnAnySettingChanged" />
                                                <TextBlock Text="开启后会在数据目录保存分段音频与 VAD 时间线，便于排查断句或识别延迟问题。"
                                                           Style="{StaticResource CaptionText}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,8,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>

                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <Grid x:Name="AboutPage" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="32,24,32,32">
                                <TextBlock Text="关于" Style="{StaticResource PageTitleText}" Margin="0,0,0,16" />

                                <!-- 卡片一：品牌标识 + 版本与定位概览 -->
                                <Border Style="{StaticResource HeroPanelBorder}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="18" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- 与系统托盘一致的深青蓝双语字幕几何图标 -->
                                        <Border Grid.Column="0"
                                                Width="58"
                                                Height="58"
                                                CornerRadius="14"
                                                BorderBrush="#40FFFFFF"
                                                BorderThickness="1"
                                                VerticalAlignment="Top">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#163247" Offset="0" />
                                                    <GradientStop Color="#0E1D2B" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <Grid>
                                                <StackPanel VerticalAlignment="Center" Margin="11,0,11,2">
                                                    <Border Height="5.5" CornerRadius="2.75" Background="#F5FFFFFF" Margin="0,0,4,6" />
                                                    <Border Height="5.5" CornerRadius="2.75" Background="#FFE299" Margin="0,0,13,0" />
                                                </StackPanel>
                                                <Border Width="14"
                                                        Height="14"
                                                        CornerRadius="7"
                                                        Background="#0E1D2B"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Bottom"
                                                        Margin="0,0,5,5">
                                                    <Ellipse Width="9"
                                                             Height="9"
                                                             Fill="{DynamicResource AcousticLiveBrush}"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center" />
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="StreamTranslator"
                                                           FontSize="20"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                           VerticalAlignment="Center" />
                                                <Border Background="{DynamicResource AcousticLiveSoftBrush}"
                                                        BorderBrush="{DynamicResource AcousticLiveBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="10"
                                                        Padding="9,2"
                                                        Margin="10,0,0,0"
                                                        VerticalAlignment="Center">
                                                    <TextBlock x:Name="AboutVersionText"
                                                               Text="V0.2.4"
                                                               FontSize="11.5"
                                                               FontWeight="SemiBold"
                                                               Typography.NumeralAlignment="Tabular"
                                                               Foreground="{DynamicResource AcousticLiveBrush}" />
                                                </Border>
                                            </StackPanel>

                                            <TextBlock Text="面向直播、网课与会议的 Windows 桌面实时双语字幕工具：本地 Silero VAD 智能断句，结合多服务商语音识别与上下文翻译。"
                                                       Style="{StaticResource CaptionText}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,6,0,12" />

                                            <WrapPanel>
                                                <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Padding="9,4"
                                                        Margin="0,0,8,4">
                                                    <TextBlock Text="Silero ONNX VAD 本地断句" FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                </Border>
                                                <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Padding="9,4"
                                                        Margin="0,0,8,4">
                                                    <TextBlock Text="多服务商 ASR" FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                </Border>
                                                <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Padding="9,4"
                                                        Margin="0,0,8,4">
                                                    <TextBlock Text="OpenAI 兼容翻译" FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                </Border>
                                                <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Padding="9,4"
                                                        Margin="0,0,0,4">
                                                    <TextBlock Text="Win11 Fluent Mica" FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                </Border>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- 卡片二：存储目录与诊断工具 -->
                                <Border Style="{StaticResource PanelBorder}" Padding="24,18">
                                    <StackPanel>
                                        <TextBlock Text="存储与诊断" Style="{StaticResource SectionTitleText}" Margin="0,0,0,14" />

                                        <!-- 行 1：数据目录 -->
                                        <DockPanel Margin="0,0,0,14">
                                            <ui:Button DockPanel.Dock="Right"
                                                       Click="OnOpenDataDirectoryClick"
                                                       Icon="{ui:SymbolIcon Folder24}"
                                                       Content="打开数据目录"
                                                       VerticalAlignment="Center"
                                                       Margin="16,0,0,0" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="本地数据目录"
                                                           FontSize="13.5"
                                                           FontWeight="Medium"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                <TextBlock x:Name="DataDirectoryText"
                                                           Style="{StaticResource CaptionText}"
                                                           Typography.NumeralAlignment="Tabular"
                                                           TextWrapping="Wrap"
                                                           Margin="0,3,0,0" />
                                            </StackPanel>
                                        </DockPanel>

                                        <Border Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="0,0,0,14" />

                                        <!-- 行 2：日志目录 -->
                                        <DockPanel Margin="0,0,0,14">
                                            <ui:Button DockPanel.Dock="Right"
                                                       Click="OnOpenLogsDirectoryClick"
                                                       Icon="{ui:SymbolIcon DocumentText24}"
                                                       Content="打开日志目录"
                                                       VerticalAlignment="Center"
                                                       Margin="16,0,0,0" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="运行日志"
                                                           FontSize="13.5"
                                                           FontWeight="Medium"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                <TextBlock x:Name="AboutLogsDirectoryText"
                                                           Text="包含应用主日志、ASR Worker 与翻译 Worker 排查日志"
                                                           Style="{StaticResource CaptionText}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,3,0,0" />
                                            </StackPanel>
                                        </DockPanel>

                                        <Border Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="0,0,0,14" />

                                        <!-- 行 3：复制诊断报告 -->
                                        <DockPanel>
                                            <ui:Button DockPanel.Dock="Right"
                                                       Click="OnCopyDiagnosticsClick"
                                                       Icon="{ui:SymbolIcon Copy24}"
                                                       Content="复制诊断信息"
                                                       VerticalAlignment="Center"
                                                       Margin="16,0,0,0" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="一键诊断摘要"
                                                           FontSize="13.5"
                                                           FontWeight="Medium"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                <TextBlock Text="汇总版本、运行链路状态与当前配置信息（自动脱敏 API Key），方便反馈问题。"
                                                           Style="{StaticResource CaptionText}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,3,0,0" />
                                            </StackPanel>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>

                                <!-- 卡片三：运行环境与隐私说明 -->
                                <Border Style="{StaticResource PanelBorder}" Padding="24,18" Margin="0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="运行环境" Style="{StaticResource SectionTitleText}" Margin="0,0,0,8" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="64" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" Grid.Column="0"
                                                           Text="OS"
                                                           Style="{StaticResource CaptionText}"
                                                           LineHeight="20" />
                                                <TextBlock x:Name="AboutOsText"
                                                           Grid.Row="0" Grid.Column="1"
                                                           Text="Windows"
                                                           Style="{StaticResource CaptionText}"
                                                           Typography.NumeralAlignment="Tabular"
                                                           TextWrapping="Wrap"
                                                           LineHeight="20" />
                                                <TextBlock Grid.Row="1" Grid.Column="0"
                                                           Text="Runtime"
                                                           Style="{StaticResource CaptionText}"
                                                           Margin="0,3,0,0"
                                                           LineHeight="20" />
                                                <TextBlock x:Name="AboutRuntimeText"
                                                           Grid.Row="1" Grid.Column="1"
                                                           Text=".NET 10"
                                                           Style="{StaticResource CaptionText}"
                                                           Typography.NumeralAlignment="Tabular"
                                                           TextWrapping="Wrap"
                                                           Margin="0,3,0,0"
                                                           LineHeight="20" />
                                            </Grid>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="数据与隐私" Style="{StaticResource SectionTitleText}" Margin="0,0,0,8" />
                                            <TextBlock Text="音频捕获、电平计算与 Silero VAD 断句均在本地完成；仅在开启识别或翻译时，按你自行配置的接口地址发送语音片段或字幕文本，配置文件与历史记录仅保存在本地数据目录。"
                                                       Style="{StaticResource CaptionText}"
                                                       TextWrapping="Wrap"
                                                       LineHeight="19" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </ui:NavigationView.ContentOverlay>
        </ui:NavigationView>
        <ui:ContentDialogHost x:Name="RootContentDialogHost" Grid.RowSpan="2" />
        <ui:SnackbarPresenter x:Name="RootSnackbarPresenter"
                              Grid.RowSpan="2"
                              Panel.ZIndex="20"
                              AutomationProperties.AutomationId="RootSnackbarPresenter"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Bottom"
                              Margin="24,0,24,28" />
        <Border x:Name="ClosingOverlay"
                AutomationProperties.AutomationId="ClosingOverlay"
                Grid.RowSpan="2"
                Panel.ZIndex="40"
                Background="#66000000"
                Visibility="Collapsed">
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="32,24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <ui:ProgressRing IsIndeterminate="True"
                                     Width="24"
                                     Height="24"
                                     Margin="0,0,12,0" />
                    <TextBlock Text="正在停止字幕并保存设置…"
                               FontSize="14"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</ui:FluentWindow>
