<ui:FluentWindow x:Class="StreamTranslator.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="StreamTranslator"
                 Width="1120"
                 Height="760"
                 MinWidth="960"
                 MinHeight="640"
                 ResizeMode="CanResize"
                 WindowStartupLocation="CenterScreen"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 ExtendsContentIntoTitleBar="True"
                 Background="Transparent"
                 Loaded="OnLoaded"
                 Closing="OnClosing">
    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="AppTitleBar"
                     Grid.Row="0"
                     Title=""
                     Height="48"
                     ShowMinimize="True"
                     ShowMaximize="True"
                     ShowClose="True"
                     ForceShutdown="False"
                     Background="{StaticResource ChromeBrush}">
            <ui:TitleBar.Header>
                <TextBlock Text="StreamTranslator"
                           AutomationProperties.AutomationId="TitleBarAppTitle"
                           FontSize="13"
                           FontWeight="Normal"
                           Margin="16,0,0,0"
                           VerticalAlignment="Center" />
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <ui:NavigationView x:Name="MainNavigation"
                           Grid.Row="1"
                           AutomationProperties.AutomationId="MainNavigation"
                           PaneDisplayMode="LeftFluent"
                           IsPaneOpen="True"
                           IsPaneToggleVisible="False"
                           IsBackButtonVisible="Collapsed"
                           HeaderVisibility="Collapsed"
                           AlwaysShowHeader="False"
                           Background="Transparent">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="主页"
                                       Tag="HomePage"
                                       AutomationProperties.AutomationId="NavHomePage"
                                       AutomationProperties.ItemStatus="Active"
                                       FontSize="12"
                                       Click="OnNavClick"
                                       IsActive="True">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Home24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="字幕历史"
                                       Tag="SubtitleHistoryPage"
                                       AutomationProperties.AutomationId="NavSubtitleHistoryPage"
                                       AutomationProperties.ItemStatus="Inactive"
                                       FontSize="12"
                                       Click="OnNavClick">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="ClosedCaption24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="设置"
                                       Tag="SettingsPage"
                                       AutomationProperties.AutomationId="NavSettingsPage"
                                       AutomationProperties.ItemStatus="Inactive"
                                       FontSize="12"
                                       Click="OnNavClick">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Settings24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="关于"
                                       Tag="AboutPage"
                                       AutomationProperties.AutomationId="NavAboutPage"
                                       AutomationProperties.ItemStatus="Inactive"
                                       FontSize="12"
                                       Click="OnNavClick">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Info24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.FooterMenuItems>

            <ui:NavigationView.ContentOverlay>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="28,22,28,28">
                        <Grid x:Name="HomePage">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,18">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Home24"
                                                       FontSize="24"
                                                       Margin="0,0,10,0"
                                                       VerticalAlignment="Center" />
                                        <TextBlock Text="实时字幕"
                                                   FontSize="24"
                                                   FontWeight="Medium"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Border DockPanel.Dock="Right"
                                            HorizontalAlignment="Right"
                                            Background="#E8F1FF"
                                            BorderBrush="#B9D1FF"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="10,5">
                                        <TextBlock x:Name="HomeStateBadgeText"
                                                   Text="就绪"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold" />
                                    </Border>
                                </DockPanel>

                                <Border x:Name="HomeControlBar"
                                        Style="{StaticResource PanelBorder}"
                                        Padding="30">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,22">
                                            <TextBlock Text="字幕概览"
                                                       AutomationProperties.AutomationId="HomeOverviewPanel"
                                                       FontSize="16"
                                                       FontWeight="Medium"
                                                       Foreground="{StaticResource PrimaryTextBrush}" />
                                            <StackPanel DockPanel.Dock="Right"
                                                        Orientation="Horizontal"
                                                        HorizontalAlignment="Right">
                                                <ui:Button x:Name="StartStopButton"
                                                           AutomationProperties.AutomationId="StartStopButton"
                                                           Click="OnStartStopClick"
                                                           Height="38"
                                                           MinWidth="116"
                                                           Padding="14,0"
                                                           FontSize="14"
                                                           Margin="0,0,8,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <ui:SymbolIcon x:Name="StartStopIcon" Symbol="Play24" Margin="0,0,8,0" />
                                                        <TextBlock x:Name="StartStopText" Text="开始字幕" />
                                                    </StackPanel>
                                                </ui:Button>
                                                <ui:Button x:Name="HomeFloatingWindowButton"
                                                           AutomationProperties.AutomationId="HomeFloatingWindowButton"
                                                           AutomationProperties.Name="显示悬浮窗"
                                                           Click="OnShowFloatingWindowClick"
                                                           Height="38"
                                                           MinWidth="112"
                                                           Padding="12,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <ui:SymbolIcon x:Name="FloatingWindowIcon" Symbol="Window24" Margin="0,0,8,0" />
                                                        <TextBlock Text="悬浮窗" />
                                                    </StackPanel>
                                                </ui:Button>
                                            </StackPanel>
                                        </DockPanel>

                                        <Grid Margin="0,0,0,24">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="24" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="24" />
                                                <ColumnDefinition Width="300" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="当前状态" Style="{StaticResource FieldLabelText}" />
                                                <TextBlock x:Name="HomeRuntimeSummaryText"
                                                           AutomationProperties.AutomationId="HomeControlBar"
                                                           Text="未启动，等待开始"
                                                           FontSize="15"
                                                           FontWeight="Medium"
                                                           Foreground="{StaticResource PrimaryTextBrush}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="输出设备" Style="{StaticResource FieldLabelText}" />
                                                <TextBlock x:Name="CurrentAudioDeviceText"
                                                           AutomationProperties.AutomationId="HomeAudioDeviceText"
                                                           Text="默认设备"
                                                           FontSize="14"
                                                           Foreground="{StaticResource PrimaryTextBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="4">
                                                <DockPanel Margin="0,0,0,8">
                                                    <TextBlock Text="输入电平" Style="{StaticResource FieldLabelText}" />
                                                    <TextBlock x:Name="HomeAudioLevelText"
                                                               DockPanel.Dock="Right"
                                                               Text="0%"
                                                               FontSize="13"
                                                               Foreground="{StaticResource SecondaryTextBrush}"
                                                               HorizontalAlignment="Right" />
                                                </DockPanel>
                                                <ProgressBar x:Name="AudioLevelBar"
                                                             AutomationProperties.AutomationId="HomeAudioLevelBar"
                                                             Minimum="0"
                                                             Maximum="100"
                                                             Height="8" />
                                            </StackPanel>
                                        </Grid>

                                        <Border Height="1"
                                                Background="{StaticResource StrokeBrush}"
                                                Margin="0,0,0,20" />

                                        <TextBlock Text="运行链路"
                                                   FontSize="13"
                                                   FontWeight="Medium"
                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                   Margin="0,0,0,12" />
                                        <Grid Margin="0,0,0,22">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="18" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <StackPanel Grid.Row="0" Grid.Column="0">
                                                <TextBlock Text="音频输入" Style="{StaticResource FieldLabelText}" />
                                                <TextBlock x:Name="AudioStatusText"
                                                           AutomationProperties.AutomationId="OverviewAudioInputStatus"
                                                           Text="未启动"
                                                           FontSize="15"
                                                           FontWeight="Medium" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="0" Grid.Column="1">
                                                <TextBlock Text="语音检测" Style="{StaticResource FieldLabelText}" />
                                                <TextBlock x:Name="VadStatusText"
                                                           AutomationProperties.AutomationId="OverviewSpeechDetectionStatus"
                                                           Text="等待模型"
                                                           FontSize="15"
                                                           FontWeight="Medium" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="0" Grid.Column="2">
                                                <TextBlock Text="识别进程" Style="{StaticResource FieldLabelText}" />
                                                <TextBlock x:Name="WorkerStatusText"
                                                           AutomationProperties.AutomationId="OverviewRecognitionWorkerStatus"
                                                           Text="未启动"
                                                           FontSize="15"
                                                           FontWeight="Medium" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="2" Grid.Column="0">
                                                <TextBlock Text="识别接口" Style="{StaticResource FieldLabelText}" />
                                                <TextBlock x:Name="ApiStatusText"
                                                           AutomationProperties.AutomationId="OverviewRecognitionApiStatus"
                                                           Text="未测试"
                                                           FontSize="15"
                                                           FontWeight="Medium" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="2" Grid.Column="1">
                                                <TextBlock Text="字幕输出" Style="{StaticResource FieldLabelText}" />
                                                <TextBlock x:Name="SubtitleOutputStatusText"
                                                           AutomationProperties.AutomationId="OverviewSubtitleOutputStatus"
                                                           Text="等待字幕"
                                                           FontSize="15"
                                                           FontWeight="Medium" />
                                            </StackPanel>
                                        </Grid>

                                    </StackPanel>
                                </Border>

                                <Border x:Name="HomeIssuesCard"
                                        Style="{StaticResource PanelBorder}"
                                        Padding="30,22">
                                    <StackPanel>
                                        <TextBlock Text="问题"
                                                   AutomationProperties.AutomationId="HomeIssuesPanel"
                                                   FontSize="13"
                                                   FontWeight="Medium"
                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                   Margin="0,0,0,10" />
                                        <TextBlock x:Name="LastErrorText"
                                                   Text="无"
                                                   TextWrapping="Wrap"
                                                   FontSize="14"
                                                   Foreground="{StaticResource PrimaryTextBrush}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <Grid x:Name="SubtitleHistoryPage" Visibility="Collapsed">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,18">
                                    <TextBlock Text="字幕历史" FontSize="24" FontWeight="Medium" />
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <ui:Button Click="OnCopySelectedClick" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Copy24" Margin="0,0,8,0" />
                                                <TextBlock Text="复制选中" />
                                            </StackPanel>
                                        </ui:Button>
                                        <ui:Button Click="OnCopyRecentClick" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="History24" Margin="0,0,8,0" />
                                                <TextBlock Text="复制最近 10 条" />
                                            </StackPanel>
                                        </ui:Button>
                                        <ui:Button Click="OnCopyAllClick" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="ClipboardTextLtr24" Margin="0,0,8,0" />
                                                <TextBlock Text="复制当天全部" />
                                            </StackPanel>
                                        </ui:Button>
                                        <ui:Button AutomationProperties.AutomationId="ClearHistoryButton"
                                                   Click="OnClearHistoryClick">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Dismiss24" Margin="0,0,8,0" />
                                                <TextBlock Text="清空当天历史" />
                                            </StackPanel>
                                        </ui:Button>
                                    </StackPanel>
                                </DockPanel>

                                <Border Style="{StaticResource PanelBorder}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top"
                                                   Text="今天"
                                                   Style="{StaticResource SectionTitleText}" />
                                        <Grid>
                                            <TextBlock x:Name="SubtitlePlaceholderText"
                                                       Text="开始字幕后，这里会保存今天的字幕记录。"
                                                       Margin="12,10"
                                                       Foreground="{StaticResource SecondaryTextBrush}"
                                                       FontSize="14"
                                                       IsHitTestVisible="False" />
                                            <ListBox x:Name="SubtitleList"
                                                     AutomationProperties.AutomationId="SubtitleHistoryList"
                                                     MinHeight="500"
                                                     BorderThickness="0"
                                                     Background="Transparent"
                                                     HorizontalContentAlignment="Stretch"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                                <ListBox.ItemContainerStyle>
                                                    <Style TargetType="{x:Type ListBoxItem}">
                                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                        <Setter Property="Padding" Value="12,8" />
                                                    </Style>
                                                </ListBox.ItemContainerStyle>
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid HorizontalAlignment="Stretch">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="64" />
                                                                <ColumnDefinition Width="12" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0"
                                                                       Text="{Binding GeneratedTimeText}"
                                                                       FontFamily="Consolas"
                                                                       FontSize="12"
                                                                       Foreground="{StaticResource SecondaryTextBrush}"
                                                                       Margin="0,2,0,0"
                                                                       VerticalAlignment="Top" />
                                                            <TextBlock Grid.Column="2"
                                                                       Text="{Binding SourceText}"
                                                                       TextWrapping="Wrap"
                                                                       FontSize="15"
                                                                       LineHeight="22"
                                                                       Foreground="{StaticResource PrimaryTextBrush}"
                                                                       HorizontalAlignment="Stretch" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </Grid>
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <Grid x:Name="SettingsPage" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="设置" FontSize="24" FontWeight="Medium" Margin="0,0,0,18" />

                                <Border Style="{StaticResource PanelBorder}">
                                    <StackPanel>
                                        <TextBlock Text="音频"
                                                   AutomationProperties.AutomationId="SettingsAudioGroup"
                                                   Style="{StaticResource SectionTitleText}" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="24" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,12">
                                                <TextBlock Text="输出设备" Style="{StaticResource FieldLabelText}" />
                                                <ComboBox x:Name="AudioDeviceComboBox"
                                                          Height="36"
                                                          SelectionChanged="OnAudioDeviceSelectionChanged" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,12">
                                                <TextBlock Text="默认设备" Style="{StaticResource FieldLabelText}" />
                                                <ui:ToggleSwitch x:Name="FollowDefaultDeviceSwitch"
                                                                 Content="跟随系统默认设备"
                                                                 IsChecked="True" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,12">
                                                <TextBlock Text="断句等待" Style="{StaticResource FieldLabelText}" />
                                                <ui:NumberBox x:Name="EndSilenceBox"
                                                              Value="300"
                                                              Minimum="200"
                                                              Maximum="800"
                                                              SmallChange="50"
                                                              LargeChange="100"
                                                              Width="180"
                                                              HorizontalAlignment="Left" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,12">
                                                <TextBlock Text="最短片段" Style="{StaticResource FieldLabelText}" />
                                                <ui:NumberBox x:Name="MinSegmentBox"
                                                              Value="900"
                                                              Minimum="300"
                                                              Maximum="3000"
                                                              SmallChange="100"
                                                              LargeChange="300"
                                                              Width="180"
                                                              HorizontalAlignment="Left" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource PanelBorder}">
                                    <StackPanel>
                                        <TextBlock Text="识别服务"
                                                   AutomationProperties.AutomationId="SettingsRecognitionGroup"
                                                   Style="{StaticResource SectionTitleText}" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="24" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,12">
                                                <TextBlock Text="API Key" Style="{StaticResource FieldLabelText}" />
                                                <PasswordBox x:Name="ApiKeyBox" Height="36" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,12">
                                                <TextBlock Text="Base URL" Style="{StaticResource FieldLabelText}" />
                                                <TextBox x:Name="BaseUrlBox" Height="36" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,12">
                                                <TextBlock Text="Model" Style="{StaticResource FieldLabelText}" />
                                                <TextBox x:Name="ModelBox" Text="mimo-v2.5-asr" Height="36" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,12">
                                                <TextBlock Text="Language" Style="{StaticResource FieldLabelText}" />
                                                <ComboBox x:Name="LanguageBox" Height="36" SelectedIndex="0">
                                                    <ComboBoxItem Content="auto" />
                                                    <ComboBoxItem Content="zh" />
                                                    <ComboBoxItem Content="en" />
                                                </ComboBox>
                                            </StackPanel>
                                            <StackPanel Grid.Row="2" Grid.Column="0">
                                                <TextBlock Text="请求超时 ms" Style="{StaticResource FieldLabelText}" />
                                                <ui:NumberBox x:Name="TimeoutBox"
                                                              Value="30000"
                                                              Minimum="5000"
                                                              Maximum="120000"
                                                              SmallChange="1000"
                                                              LargeChange="5000"
                                                              Width="180"
                                                              HorizontalAlignment="Left" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="2" Grid.Column="2">
                                                <TextBlock Text="最大并发" Style="{StaticResource FieldLabelText}" />
                                                <ui:NumberBox x:Name="MaxConcurrencyBox"
                                                              Value="2"
                                                              Minimum="1"
                                                              Maximum="4"
                                                              SmallChange="1"
                                                              LargeChange="1"
                                                              Width="180"
                                                              HorizontalAlignment="Left" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource PanelBorder}">
                                    <StackPanel>
                                        <TextBlock Text="悬浮字幕窗"
                                                   AutomationProperties.AutomationId="SettingsFloatingGroup"
                                                   Style="{StaticResource SectionTitleText}" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="24" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,12">
                                                <TextBlock Text="字号" Style="{StaticResource FieldLabelText}" />
                                                <ui:NumberBox x:Name="FloatingFontSizeBox"
                                                              Value="28"
                                                              Minimum="18"
                                                              Maximum="72"
                                                              SmallChange="1"
                                                              LargeChange="4"
                                                              Width="180"
                                                              HorizontalAlignment="Left" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,12">
                                                <TextBlock Text="显示行数" Style="{StaticResource FieldLabelText}" />
                                                <ui:NumberBox x:Name="FloatingLinesBox"
                                                              Value="2"
                                                              Minimum="1"
                                                              Maximum="3"
                                                              SmallChange="1"
                                                              LargeChange="1"
                                                              Width="180"
                                                              HorizontalAlignment="Left" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="0">
                                                <TextBlock Text="透明度" Style="{StaticResource FieldLabelText}" />
                                                <Slider x:Name="FloatingOpacitySlider"
                                                        Minimum="0.35"
                                                        Maximum="0.95"
                                                        Value="0.72"
                                                        Width="260"
                                                        HorizontalAlignment="Left" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                                                <ui:Button Click="OnShowFloatingWindowClick" Margin="0,0,8,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <ui:SymbolIcon Symbol="Window24" Margin="0,0,8,0" />
                                                        <TextBlock Text="显示/隐藏" />
                                                    </StackPanel>
                                                </ui:Button>
                                                <ui:Button Click="OnToggleFloatingLockClick">
                                                    <StackPanel Orientation="Horizontal">
                                                        <ui:SymbolIcon Symbol="LockClosed24" Margin="0,0,8,0" />
                                                        <TextBlock Text="锁定/解锁" />
                                                    </StackPanel>
                                                </ui:Button>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource PanelBorder}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="快捷键"
                                                       AutomationProperties.AutomationId="SettingsDiagnosticsGroup"
                                                       Style="{StaticResource SectionTitleText}" />
                                            <ui:ToggleSwitch x:Name="HotkeysEnabledSwitch"
                                                             Content="启用全局快捷键"
                                                             IsChecked="True" />
                                            <TextBlock Text="Ctrl+Alt+S 开始/停止，Ctrl+Alt+H 隐藏/显示，Ctrl+Alt+L 锁定/解锁"
                                                       Foreground="{StaticResource SecondaryTextBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,6,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="诊断" Style="{StaticResource SectionTitleText}" />
                                            <ui:ToggleSwitch x:Name="DiagnosticsSwitch"
                                                             Content="诊断模式" />
                                            <TextBlock Text="开启后保存分段音频和 VAD 时间线"
                                                       Foreground="{StaticResource SecondaryTextBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,6,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <Grid x:Name="AboutPage" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="关于" FontSize="24" FontWeight="Medium" Margin="0,0,0,18" />
                                <Border Style="{StaticResource PanelBorder}">
                                    <StackPanel>
                                        <TextBlock Text="StreamTranslator V1.0" Style="{StaticResource SectionTitleText}" />
                                        <TextBlock x:Name="DataDirectoryText"
                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,14" />
                                        <StackPanel Orientation="Horizontal">
                                            <ui:Button Click="OnOpenDataDirectoryClick" Margin="0,0,8,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="Folder24" Margin="0,0,8,0" />
                                                    <TextBlock Text="打开数据目录" />
                                                </StackPanel>
                                            </ui:Button>
