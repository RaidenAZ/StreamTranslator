<Window x:Class="StreamTranslator.App.FloatingSubtitleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="字幕"
        Width="760"
        MinWidth="420"
        MinHeight="76"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        MouseLeftButtonDown="OnMouseLeftButtonDown">
    <Border x:Name="Chrome"
            CornerRadius="8"
            Background="#CC111827"
            BorderBrush="#80FFFFFF"
            BorderThickness="1"
            Padding="18,12">
        <ItemsControl x:Name="SubtitleGroups"
                      ItemsSource="{Binding Entries, RelativeSource={RelativeSource AncestorType=Window}}"
                      HorizontalContentAlignment="Stretch">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,4,0,6">
                        <TextBlock Text="{Binding SourceText}"
                                   Foreground="White"
                                   FontSize="{DynamicResource FloatingSourceFontSize}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   LineStackingStrategy="BlockLineHeight" />
                        <TextBlock Text="{Binding TranslatedText}"
                                   Visibility="{Binding TranslationVisibility}"
                                   Foreground="#D9FFFFFF"
                                   FontSize="{DynamicResource FloatingTranslationFontSize}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Margin="0,3,0,0"
                                   LineStackingStrategy="BlockLineHeight" />
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Border>
</Window>
